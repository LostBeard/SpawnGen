<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpawnGen.Nodes.Core</RootNamespace>
    <Description>Primitive, latent and image utility nodes for SpawnGen (host-side math only).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpawnGen.Engine\SpawnGen.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The model-saving nodes write through the same result helpers as Save Image. -->
    <InternalsVisibleTo Include="SpawnGen.Nodes.ML" />
  </ItemGroup>
  <ItemGroup>
    <!-- Convert SDR to HDR's gain curve, measured from ComfyUI by tools/parity/make_sdr_to_hdr_table.py. -->
    <EmbeddedResource Include="Resources\sdr_to_hdr_gain.bin" LogicalName="SpawnGen.Nodes.Core.sdr_to_hdr_gain.bin" />
  </ItemGroup>

</Project>
