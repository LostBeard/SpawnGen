<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpawnGen.Nodes.ML</RootNamespace>
    <Description>ML nodes for SpawnGen backed by SpawnDev.ILGPU.ML (checkpoint loader, CLIP encode, KSampler, VAE decode).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpawnGen.Nodes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpawnDev.ILGPU.ML" Version="5.4.0" />
    <!-- 5.4.1 corrupts streamed weight uploads on some AMD OpenCL drivers (Polaris): SD-Turbo output turns to noise. 5.4.2 fixes it. -->
    <PackageReference Include="SpawnDev.ILGPU" Version="5.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpawnGen.Engine\SpawnGen.Engine.csproj" />
    <ProjectReference Include="..\SpawnGen.Nodes.Core\SpawnGen.Nodes.Core.csproj" />
  </ItemGroup>

</Project>
