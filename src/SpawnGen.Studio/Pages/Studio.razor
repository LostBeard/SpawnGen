        if (key == "h" && mods == Modifiers.None) { ToggleHistory(); InvokeAsync(StateHasChanged); return true; }
        if (key == "escape" && _lightbox is not null) { _lightbox = null; InvokeAsync(StateHasChanged); return true; }
