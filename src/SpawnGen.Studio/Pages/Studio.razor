    readonly HashSet<string> _libraryClosed = new();
    int _placed;

    void ToggleLibrary()
    {
        _libraryOpen = !_libraryOpen;
        if (_libraryOpen) _workflowsOpen = false; // one sidebar on the left
        _studio?.Focus();
    }

    void OnLibraryFilter(ChangeEventArgs e) => _libraryFilter = e.Value?.ToString() ?? "";

    void ToggleCategory(string category)
    {
        if (!_libraryClosed.Remove(category)) _libraryClosed.Add(category);
    }

    IEnumerable<IGrouping<string, NodeSchema>> LibraryGroups()
    {
        var words = _libraryFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return Registry.Schemas
            .Where(s => !s.DevOnly)
            .Where(s => words.All(w => s.DisplayName.Contains(w, StringComparison.OrdinalIgnoreCase) || s.Id.Contains(w, StringComparison.OrdinalIgnoreCase) || s.Category.Contains(w, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(s => s.DisplayName)
            .GroupBy(s => s.Category)
            .OrderBy(g => g.Key);
    }

    /// <summary>A click in the library places the node a little off the centre of the free part of the canvas, each one a step further so they do not stack.</summary>
    void PlaceFromLibrary(NodeSchema schema)
    {
        var at = _view.Viewport.ScreenToWorld(new Point(_view.ScreenSize.X / 2 + 130, _view.ScreenSize.Y / 2));
        int cascade = _placed++ % 6 * 24;
        _view.PlaceNode(schema.Id, new Point(at.X + cascade, at.Y + cascade));
        _studio?.Focus();
    }

    /// <summary>A library entry dropped on the canvas (see <c>spawngenEnableDrop</c> in index.html): (x, y) are canvas pixels.</summary>
    [JSInvokable]
    public void OnNodeDropped(string classType, double x, double y)
    {
        if (Registry.GetSchema(classType) is null) return;
        _view.PlaceNode(classType, _view.Viewport.ScreenToWorld(new Point(x, y)));
        _studio?.Focus();
    }

    /// <summary>The Studio's shortcuts, by their default keys (the canvas turns a key the user rebound into its command's default first).</summary>
    bool OnShortcut(string key, Modifiers mods)
    {
        const Modifiers Ctrl = Modifiers.Ctrl, Shift = Modifiers.Shift, Alt = Modifiers.Alt, None = Modifiers.None;
        Action? action = (key, mods & (Ctrl | Shift | Alt)) switch
        {
            ("n", None) => ToggleLibrary,
            ("w", None) => () => _ = ToggleWorkflowsAsync(_appsTab),
            ("h", None) => ToggleHistory,
            ("i", None) => ToggleProperties,
            ("m", None) => ToggleModels,
            ("s", Ctrl) => () => _ = SaveToLibraryAsync(),
            // The file picker opens while the key press still counts as the user's action (browsers allow it only then).
            ("o", Ctrl) => () => ((IJSInProcessRuntime)Interop).InvokeVoid("spawngenOpenWorkflowFile"),
            ("enter", Ctrl) => () => _ = QueueAsync(),
            ("enter", Ctrl | Shift) => () => _ = QueueAsync(front: true),
            ("enter", Ctrl | Alt) => () => _ = InterruptAsync(),
            ("=", Alt) => () => _view.ZoomStep(zoomIn: true),
            ("-", Alt) => () => _view.ZoomStep(zoomIn: false),
            ("m", Alt | Shift) => () => { _settings.ShowMinimap = !_settings.ShowMinimap; ApplySettings(); },
            ("m", Alt) => ToggleAppMode,
            (",", Ctrl) => () => _settingsOpen = !_settingsOpen,
            ("k", Ctrl | Shift) => ToggleShortcuts,
            ("escape", _) => EscapeAction(),
            _ => null,
        };
        if (action is null) return false;
        action();
        InvokeAsync(StateHasChanged);
        return true;
    }

    /// <summary>Escape after the editor had nothing to clear: closes the picture or the shortcuts list, else steps out of a subgraph (as ComfyUI's Exit Subgraph).</summary>
    Action? EscapeAction() =>
        _lightbox is not null ? () => _lightbox = null
        : _shortcutsOpen ? () => _shortcutsOpen = false
        : _settingsOpen ? () => _settingsOpen = false
        : _subgraphStack.Count > 0 ? () => ExitSubgraphTo(_subgraphStack.Count - 1)
        : null;

    void ShowMessage(string text)
    {
        _message = text;
        _toastTimer?.Cancel();
        _toastTimer = new CancellationTokenSource();
        var token = _toastTimer.Token;
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(3500, token).ContinueWith(t =>
        {
            if (t.IsCanceled) return Task.CompletedTask;
            _message = null;
            return InvokeAsync(StateHasChanged);
        });
    }

    // ---- running on the server ----

    readonly RunVisuals _visuals = new();
    readonly ImageCache _images = new();
    bool _running;
    int _batchCount = 1;
    int _queueRemaining;
    string? _statusText;
    string? _executingTitle;
    IEngineClient? _engine;
    readonly List<IEngineClient> _engines = [];

    /// <summary>Finds the engines this page can use: a SpawnGen server (when the page was served by one) and this browser's own WebGPU.</summary>
    async Task StartServerAsync()
    {
        if (await Server.ProbeAsync())
        {
            _serverStore = true; // the workflow library is the server's user folder
            _store = null;
            Server.Start();
            // The server's custom nodes are not compiled into this page: learn them from its catalogue so they can be placed and wired here (they run on the server).
            _serverSchemas = await Server.FetchSchemasAsync();
            foreach (var schema in _serverSchemas)
                if (Registry.GetSchema(schema.Id) is null) Registry.AddRemote(schema);
            _engines.Add(Server); // a native GPU is the faster choice when there is one, so it is the default
            await LoadPastRunsAsync(Server);
        }
        if (Browser.WebGpuAvailable) _engines.Add(Browser);
        _engine = _engines.FirstOrDefault();
        ApplyEngineChoices();
        await RefreshInputImagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    IReadOnlyList<NodeSchema> _serverSchemas = [];
    readonly Dictionary<(string Node, string Input), WidgetSpec> _pageChoices = new();   // the combos as this page knows them, for when the engine changes back

    /// <summary>
    /// The lists in combos (checkpoints, upscale models...) are what the engine that runs the graph has: a server may offer checkpoints this page does not know,
    /// the browser engine only its own. Switching the engine swaps the lists.
    /// </summary>
    void ApplyEngineChoices()
    {
        foreach (var ((node, input), widget) in _pageChoices) Registry.ReplaceWidget(node, input, widget);
        _pageChoices.Clear();
        if (!ReferenceEquals(_engine, Server)) return;
        foreach (var server in _serverSchemas)
        {
            if (Registry.GetSchema(server.Id) is not { } local) continue;
            foreach (var input in server.Inputs)
            {
                if (input.Widget is not { Kind: WidgetKind.Combo } remote || local.FindInput(input.Name)?.Widget is not { Kind: WidgetKind.Combo } mine) continue;
                var theirs = remote.ResolveOptions();
                if (theirs.SequenceEqual(mine.ResolveOptions())) continue;
                _pageChoices[(server.Id, input.Name)] = mine;
                Registry.ReplaceWidget(server.Id, input.Name, mine with { Options = theirs, OptionsProvider = null });
            }
        }
        _view.Invalidate();
    }

    async Task OnEngineChosen(ChangeEventArgs e)
    {
        _engine = _engines.FirstOrDefault(x => x.Name == e.Value?.ToString()) ?? _engine;
        ApplyEngineChoices();
        await RefreshInputImagesAsync();
        ShowMessage($"Running on: {_engine?.Name}.");
    }

    /// <summary>ComfyUI's refresh button on Load Image (from Outputs) (control_after_refresh "first"): the list is read again and the newest output picked.</summary>
    async Task PickNewestOutputAsync(int nodeId)
    {
        await RefreshInputImagesAsync();
        if (OutputFiles.List() is [var newest, ..]) { _doc.SetWidget(nodeId, "image", newest); _doc.EndGesture(); }
        else ShowMessage("There are no output pictures yet.");
    }

    /// <summary>Load Image offers the pictures of the engine in use; the page shows that engine's list through the shared input store.</summary>
    async Task RefreshInputImagesAsync()
    {
        if (_engine is null) return;
        var names = await _engine.ListInputImagesAsync();
        // The server's pictures and folders stay on the server: its store here is only the choice list. Switching back to the browser engine
        // must give Load Image the browser's own pictures again.
        InputFiles.Store = _engine is BrowserEngine browser ? browser.Inputs : new ListedInputStore(names, await _engine.ListInputFoldersAsync());
        var outputs = await _engine.ListOutputFilesAsync();
        OutputFiles.Lister = () => outputs;
        _view.Invalidate();
    }

    async Task OnUploadChosen(InputFileChangeEventArgs e)
    {
        if (_engine is null) { ShowMessage("There is no engine to upload to."); return; }
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var stored = await _engine.UploadImageAsync(e.File.Name, memory.ToArray());
            await RefreshInputImagesAsync();
            ShowMessage(stored is null ? $"Could not upload {e.File.Name} (only PNG, JPEG, WebP, GIF and BMP pictures, WAV sound and .latent files can be loaded)." : $"Uploaded as {stored}: pick it in a Load Image, Load Audio or Load Latent node.");
        }
        catch (IOException ex) { ShowMessage($"Could not read {e.File.Name}: {ex.Message}"); }
    }

    /// <summary>The picture names and input folders of a remote engine, shown in Load Image's and Load Image (from Folder)'s combos (the files are read on that engine).</summary>
    sealed class ListedInputStore(IReadOnlyList<string> names, IReadOnlyList<string> folders) : IInputStore
    {
        public IReadOnlyList<string> List(Func<string, bool>? filter = null) => filter is null ? names : names.Where(filter).ToList();
        public IReadOnlyList<string> Folders() => folders;
        public Task<byte[]> ReadAsync(string name) => throw new InvalidOperationException("Files are read by the engine that runs the graph.");
        public Task<string> SaveAsync(string name, byte[] bytes) => throw new InvalidOperationException("Upload goes through the engine.");
        public IReadOnlyList<StoreEntry> Entries(string folder) => throw new InvalidOperationException("Folders are read by the engine that runs the graph.");
        public bool Exists(string path) => throw new InvalidOperationException("Files are read by the engine that runs the graph.");
    }

    string RunStatus()
    {
        if (!_running && _queueRemaining == 0) return "";
        var where = _executingTitle is null ? (_running ? "Running" : "Queued") : $"Running {_executingTitle}";
        // A download is the slow part when it happens, so it wins over the loader's own stage text.
        if (_downloadText is not null) where += $": {_downloadText}";
        else if (_visuals.ProgressMax > 0) where += $" {_visuals.ProgressValue:0}/{_visuals.ProgressMax:0}";
        else if (_statusText is not null) where += $": {_statusText}";
        return where + " · ";
    }

    bool _queueNoteShown;

    /// <param name="targets">Run only these output nodes (Queue Selected Output Nodes); null runs every output.</param>
    async Task QueueAsync(bool front = false, IReadOnlyList<int>? targets = null)
    {
        if (_engine is null) { ShowMessage("There is no engine: this browser has no WebGPU and no SpawnGen server serves this page."); return; }
        int ahead = _pending.Count + (_running ? 1 : 0), queued = 0;
        _queueNoteShown = false;
        for (int run = 0, runs = Math.Clamp(_batchCount, 1, 100); run < runs; run++)
        {
            if (!await QueueOnceAsync(front, targets)) break;
            queued++;
        }
        // Say what Queue did, so a second press is a choice and not a guess.
        if (queued > 0 && !_queueNoteShown)
        {
            var what = queued == 1 ? "Queued" : $"Queued {queued} runs";
            ShowMessage(front || ahead == 0 ? (front && ahead > 0 ? $"{what}: runs next" : what) : $"{what}: {ahead} ahead");
        }
        _studio?.Focus();
    }

    /// <summary>Sends the graph once and then moves every seed on by its control after generate, as ComfyUI does. False when the run could not be queued.</summary>
    async Task<bool> QueueOnceAsync(bool front = false, IReadOnlyList<int>? targets = null)
    {
        // Inside a subgraph the canvas shows only its inside: run the tab's whole workflow, with the edit.
        var runDoc = _doc;
        if (_subgraphStack.Count > 0)
        {
            runDoc = new EditorDocument(Registry);
            ComfyWorkflow.Load(RootJson(), runDoc);
        }
        var compiled = GraphCompiler.Compile(runDoc.Graph, Registry);
        if (compiled.Graph.Nodes.Count == 0) { ShowMessage(compiled.Notes.FirstOrDefault() ?? "There is nothing to run."); return false; }
        _visuals.Errors.Clear();

        // The workflow travels with the prompt so Save Image can embed it: the picture can then be dropped back on the canvas.
        var workflow = ComfyWorkflow.Save(runDoc, _renderer.MeasureText);
        var result = await _engine!.QueueAsync(PromptJson.ToJson(compiled.Graph), workflow, front, _settings.PreviewMethod,
            targets?.Select(id => id.ToString(System.Globalization.CultureInfo.InvariantCulture)).ToList());
        if (!result.Queued)
        {
            foreach (var (node, message) in result.NodeErrors) _visuals.Errors[node] = message;
            var detail = result.NodeErrors.Count > 0 ? $" {result.NodeErrors.First().Value}" : "";
            ShowMessage($"{result.Message}.{detail}");
            _view.Invalidate();
            return false;
        }
        if (result.NodeErrors.Count > 0)
        {
            // Queued, with the output nodes whose inputs do not validate left out (as ComfyUI does): show where and why.
            foreach (var (node, message) in result.NodeErrors) _visuals.Errors[node] = message;
            ShowMessage($"Queued without the outputs that need node {string.Join(", ", result.NodeErrors.Keys)}: {result.NodeErrors.First().Value}");
            _queueNoteShown = true;
            _view.Invalidate();
        }
        if (result.PromptId is { } queuedId && !_startedIds.Remove(queuedId))
        {
            var queued = new PendingRun(queuedId, workflow, DateTime.Now, _engine.Name);
            // A front-of-queue batch puts each run at the very front in turn, so the batch runs in reverse order (as in ComfyUI).
            if (front) _pending.Insert(0, queued); else _pending.Add(queued);
        }
        if (compiled.Notes.Count > 0) { ShowMessage(compiled.Notes[0]); _queueNoteShown = true; }
        ControlAfterGenerate.ApplyAfterQueue(_doc, Registry.GetSchema, Random.Shared);
        return true;
    }

    async Task InterruptAsync()
    {
        await (_engine?.InterruptAsync() ?? Task.CompletedTask);
        _studio?.Focus();
    }

    /// <summary>The pictures (saved ones and Preview Image's, as ComfyUI's queue shows both) and sounds of the running run's history entry.</summary>
    void CollectRunOutputs(JsonObject data)
    {
        if (_history.FirstOrDefault(h => h.State == "running") is not { } run || _engine is null) return;
        string Url(JsonObject f) => _engine.ViewUrl((string)f["filename"]!, (string?)f["subfolder"], (string?)f["type"]);
        var from = (string?)data["node"] ?? (string?)data["display_node"];
        if (data["output"]?["images"] is JsonArray images)
        {
            var urls = images.OfType<JsonObject>().Where(i => (string?)i["type"] is "output" or "temp").Select(Url).ToList();
            run.Urls.AddRange(urls);
            run.Items.AddRange(urls.Select(u => new RunItem(from, "image", u)));
        }
        if (AudioOf(data) is { } clips)
        {
            var urls = clips.OfType<JsonObject>().Select(Url).ToList();
            run.Audio.AddRange(urls);
            run.Items.AddRange(urls.Select(u => new RunItem(from, "audio", u)));
        }
        if (ModelsOf(data) is { } models)
        {
            var urls = models.OfType<JsonObject>().Select(Url).ToList();
            run.Models.AddRange(urls);
            run.Items.AddRange(urls.Select(u => new RunItem(from, "model", u)));
        }
        if (TextOf(data) is { } texts) run.Items.AddRange(texts.Select(t => new RunItem(from, "text", (string?)t ?? "")));
    }

    static JsonArray? ModelsOf(JsonObject data) => data["output"]?["3d"] as JsonArray;

    void View3D(string url) => _ = Interop.InvokeVoidAsync("spawngenView3D", url, "3D model");

    static JsonArray? AudioOf(JsonObject data) => data["output"]?["audio"] as JsonArray;

    static JsonArray? TextOf(JsonObject data) => data["output"]?["text"] as JsonArray;
    static JsonArray? HistogramOf(JsonObject data) => data["output"]?["histogram"] as JsonArray;

    void OnServerEvent(JsonObject e)
    {
        var type = (string?)e["type"];
        var data = e["data"] as JsonObject ?? [];
        int? node = int.TryParse((string?)data["node"], out var n) ? n : null;

        if (type == "executed") CollectRunOutputs(data); // results of nodes inside subgraphs have no node here but belong in the history all the same

        switch (type)
        {
            case "status":
                _queueRemaining = (int?)data["status"]?["exec_info"]?["queue_remaining"] ?? 0;
                break;
            case "execution_start":
                StartHistoryEntry((string?)data["prompt_id"]);
                _visuals.BeginRun();
                _running = true;
                _statusText = null;
                _ = PollModelsAsync(); // after _running is set: the poll loop runs only while a run is going (or the Models panel is open)
                break;
            case "executing":
                _visuals.ExecutingNode = node;
                _visuals.ProgressValue = _visuals.ProgressMax = 0;
                _statusText = null;
                _executingTitle = node is { } runningId && _doc.Graph.FindNode(runningId) is { } running
                    ? running.Title ?? Registry.GetSchema(running.ClassType)?.DisplayName ?? running.ClassType : null;
                break;
            case "progress":
                _visuals.ProgressValue = (double?)data["value"] ?? 0;
                _visuals.ProgressMax = (double?)data["max"] ?? 0;
                break;
            case "preview" when node is { } previewId && _doc.Graph.FindNode(previewId) is { } previewed && (string?)data["image"] is { } dataUrl:
                previewed.Previews = [new NodePreview(dataUrl)]; // a sampler's current guess, replaced at every step
                break;
            case "node_status":
                _statusText = (string?)data["message"];
                break;
            case "executed" when node is { } audioId && _doc.Graph.FindNode(audioId) is { } audible && AudioOf(data) is { } clips:
                audible.ResultText = string.Join("\n", clips.OfType<JsonObject>().Select(c => "♪ " + (string?)c["filename"]));
                break;
            case "executed" when node is { } modelId && _doc.Graph.FindNode(modelId) is { } modelled && ModelsOf(data) is { } models:
                modelled.ResultModels = models.OfType<JsonObject>().Select(m => _engine!.ViewUrl((string)m["filename"]!, (string?)m["subfolder"], (string?)m["type"])).ToList();
                modelled.ResultText = string.Join("\n", models.OfType<JsonObject>().Select(m => "▣ "+ (string?)m["filename"] + " (open it from the right-click menu)"));
                break;
            case "executed" when node is { } boxesId && _doc.Graph.FindNode(boxesId) is { } boxed && (data["output"]?["dims"] is JsonArray):
            {
                // Create Bounding Boxes: its background is drawn under the boxes; boxes from its bboxes input set the canvas when that value is new
                // (last_incoming remembers it, so edits made since are kept until the upstream value changes again).
                boxed.BoxesBackground = data["output"]?["background_images"] is JsonArray bgs && bgs.OfType<JsonObject>().FirstOrDefault() is { } bgImage
                    ? new NodePreview(_engine!.ViewUrl((string)bgImage["filename"]!, (string?)bgImage["subfolder"], (string?)bgImage["type"])) : null;
                if (data["output"]?["input_bboxes"] is JsonArray incoming)
                {
                    var value = SpawnGen.Engine.Types.JsonLiteral.FromJson(incoming);
                    var last = boxed.Widgets.GetValueOrDefault("last_incoming");
                    if (SpawnGen.Engine.Types.JsonLiteral.ToJson(value) != SpawnGen.Engine.Types.JsonLiteral.ToJson(last))
                    {
                        _doc.SetWidget(boxesId, "editor_state", value);
                        _doc.SetWidget(boxesId, "last_incoming", value);
                        _doc.EndGesture();
                    }
                }
                break;
            }
            case "executed" when node is { } histId && _doc.Graph.FindNode(histId) is { } charted && HistogramOf(data) is { } bins:
                charted.ResultHistogram = bins.Select(b => (double?)b ?? 0).ToList();
                break;
            case "executed" when node is { } textId && _doc.Graph.FindNode(textId) is { } texted && TextOf(data) is { } texts:
                texted.ResultText = string.Join("\n", texts.Select(t => (string?)t ?? ""));
                break;
            case "executed" when node is { } compareId && _doc.Graph.FindNode(compareId) is { } compared
                && (data["output"]?["a_images"] is JsonArray || data["output"]?["b_images"] is JsonArray):
            {
                // Compare Images: the first picture of each side; with only one side given it shows alone.
                NodePreview? First(string key) => data["output"]?[key] is JsonArray list && list.OfType<JsonObject>().FirstOrDefault() is { } i
                    ? new NodePreview(_engine!.ViewUrl((string)i["filename"]!, (string?)i["subfolder"], (string?)i["type"])) : null;
                var (a, b) = (First("a_images"), First("b_images"));
                compared.Previews = a is not null ? [a] : b is not null ? [b] : [];
                compared.CompareWith = a is not null ? b : null;
                break;
            }
            case "executed" when node is { } shownId && _doc.Graph.FindNode(shownId) is { } shown:
                if (data["output"]?["images"] is JsonArray images)
                {
                    shown.Previews = images.OfType<JsonObject>()
                        .Select(i => new NodePreview(_engine!.ViewUrl((string)i["filename"]!, (string?)i["subfolder"], (string?)i["type"]))).ToList();
                }
                break;
            case "execution_error":
                int? failedNode = node;
                if (failedNode is null && int.TryParse((string?)data["node_id"], out var failedId)) failedNode = failedId;
                if (failedNode is { } badId) _visuals.Errors[badId] = (string?)data["exception_message"] ?? "failed";
                FinishHistoryEntry("failed", (string?)data["exception_message"]);
                ShowMessage($"Run failed: {(string?)data["exception_message"]}");
                _running = false;
                _visuals.EndRun();
                break;
            case "execution_success":
                FinishHistoryEntry("done", null);
                _ = RefreshInputImagesAsync(); // new outputs for Load Image (from Outputs)
                _running = false;
                _executingTitle = null;
                _visuals.EndRun();
                break;
            case "execution_interrupted":
                FinishHistoryEntry("stopped", null);
                _running = false;
                _executingTitle = null;
                _visuals.EndRun();
                ShowMessage("Stopped.");
                break;
        }
        _view.Invalidate();
        RefreshUi();
    }

    DotNetObjectReference<Studio>? _dropRef;

    public void Dispose()
    {
        Server.EventReceived -= OnServerEvent;
        Browser.EventReceived -= OnServerEvent;
        Server.ConnectionChanged -= RefreshUi;
        _images.Dispose();
        _dropRef?.Dispose();
        _studio?.Dispose();
        _toastTimer?.Cancel();
    }
}
