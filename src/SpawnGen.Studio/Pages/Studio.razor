@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnGen.Editor
@using System.Text.Json.Nodes
@using SpawnGen.Engine.Graph
@using SpawnGen.Studio.Run
@using SpawnGen.Nodes.Core
@using SpawnGen.Engine.Nodes
@using SpawnGen.Studio.Canvas
@inject SpawnJSRuntime JS
@inject IJSRuntime Interop
@inject NodeRegistry Registry
@inject ServerClient Server
@inject BrowserEngine Browser
@implements IDisposable

<div class="studio">
    <div class="toolbar" @onpointerdown="CloseMenus">
        <span class="brand">SpawnGen</span>
        <button title="Undo (Ctrl+Z)" disabled="@(!_doc.CanUndo)" @onclick="() => { _doc.Undo(); _studio?.Focus(); }">Undo</button>
        <button title="Redo (Ctrl+Y)" disabled="@(!_doc.CanRedo)" @onclick="() => { _doc.Redo(); _studio?.Focus(); }">Redo</button>
        <span class="sep"></span>
        <button title="Add a node (double-click the canvas)" @onclick="() => OpenSearch(CenterWorld(), null)">Add node</button>
        <button title="Fit all nodes in view (F)" @onclick="() => { _view.FitToView(); _studio?.Focus(); }">Fit</button>
        <span class="sep"></span>
        <label class="button" title="Open a workflow: a ComfyUI .json (workflow or API format) or a picture generated by ComfyUI or SpawnGen. You can also drop the file on the canvas.">Open<InputFile OnChange="OnFileChosen" accept=".json,.png" hidden /></label>
        <button title="Download the workflow as ComfyUI JSON" @onclick="SaveAsync">Save</button>
        <button title="Replace the graph with a starter text-to-image workflow" @onclick="LoadExample">Example</button>
        <span class="sep"></span>
        @if (_running)
        {
            <button class="danger" title="Stop the run in progress" @onclick="InterruptAsync">Stop</button>
        }
        else
        {
            <button class="primary" disabled="@(_engine is null)" @onclick="QueueAsync"
                    title="@(_engine is null ? "No engine: this browser has no WebGPU and there is no SpawnGen server." : $"Run the graph on: {_engine.Name} (Ctrl+Enter)")">Queue</button>
        }
        <select class="engine" title="Where graphs run" @onchange="OnEngineChosen">
            @foreach (var engine in _engines)
            {
                <option value="@engine.Name" selected="@(ReferenceEquals(engine, _engine))">@engine.Name</option>
            }
            @if (_engines.Count == 0)
            {
                <option>No engine available</option>
            }
        </select>
        <label class="button" title="Upload a PNG for Load Image nodes">Upload<InputFile OnChange="OnUploadChosen" accept=".png" hidden /></label>
        <label class="check" title="Batch count: how many times Queue runs the graph (each run uses the next seed per the seed widget's control after generate)">batch <input class="batch" type="number" min="1" max="100" step="1" @bind="_batchCount" @bind:event="oninput" /></label>
        <span class="status">@RunStatus()@_doc.Graph.Nodes.Count nodes, @_doc.Graph.Links.Count links, @((int)Math.Round(_view.Viewport.Scale * 100))%</span>
    </div>

    <div class="stage">
        <canvas @ref="_canvasRef" tabindex="0"></canvas>

        @if (_message is not null)
        {
            <div class="toast">@_message</div>
        }

        @if (_edit is { } e)
        {
            <div class="widget-edit" style="left:@(Px(e.Bounds.X)); top:@(Px(e.Bounds.Y)); width:@(Px(Math.Max(e.Bounds.Width, 140))); height:@(Px(e.Bounds.Height))">
                @if (e.Spec?.Kind == WidgetKind.Combo)
                {
                    <select @ref="_editRef" @onchange="args => CommitEdit(args.Value?.ToString())" @onkeydown="EditKey">
                        @foreach (var option in e.Spec.ResolveOptions())
                        {
                            <option value="@option" selected="@(option == e.Text)">@option</option>
                        }
                    </select>
                }
                else if (e.Spec?.Multiline == true)
                {
                    <textarea @ref="_editRef" @bind="e.Text" @bind:event="oninput" @onblur="() => CommitEdit(e.Text)" @onkeydown="EditKey"></textarea>
                }
                else
                {
                    <input @ref="_editRef" type="@(e.Spec?.Kind is WidgetKind.Int or WidgetKind.Float ? "number" : "text")"
                           step="@(e.Spec?.Kind == WidgetKind.Float ? "any" : "1")" @bind="e.Text" @bind:event="oninput"
                           @onblur="() => CommitEdit(e.Text)" @onkeydown="EditKey" />
                }
            </div>
        }

        @if (_search is { } s)
        {
            <div class="search-backdrop" @onclick="CloseSearch">
                <div class="search" @onclick:stopPropagation>
                    <input @ref="_searchRef" placeholder="Search nodes..." value="@s.Query" @oninput="OnSearchInput" @onkeydown="SearchKey" />
                    <ul>
                        @{ var results = SearchResults().ToList(); }
                        @for (int i = 0; i < results.Count; i++)
                        {
                            var schema = results[i];
                            var index = i;
                            <li class="@(index == s.Selected ? "on" : "")" @onclick="() => PlaceFromSearch(schema)" @onmouseover="() => s.Selected = index">
                                <span class="name">@schema.DisplayName</span>
                                <span class="cat">@schema.Category</span>
                            </li>
                        }
                        @if (results.Count == 0)
                        {
                            <li class="none">No node matches "@s.Query".</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (_menu is { } m)
        {
            <ul class="menu" style="left:@(Px(m.At.X)); top:@(Px(m.At.Y))" @onpointerdown:stopPropagation>
                @foreach (var item in m.Items)
                {
                    <li @onclick="() => { CloseMenus(); item.Action(); }">@item.Label</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    sealed class EditState
    {
        public required int NodeId { get; init; }
        public string? Name { get; init; }           // null = editing the node title
        public WidgetSpec? Spec { get; init; }
        public required Rect Bounds { get; init; }
        public required string Text { get; set; }
    }

    sealed class SearchState
    {
        public string Query { get; set; } = "";
        public int Selected { get; set; }
        public Point At { get; init; }
        public LinkDraft? Draft { get; init; }
    }

    sealed record MenuItem(string Label, Action Action);
    sealed record MenuState(Point At, List<MenuItem> Items);

    ElementReference _canvasRef, _editRef, _searchRef;
    EditorDocument _doc = null!;
    EditorView _view = null!;
    NodeRenderer _renderer = null!;
    StudioCanvas? _studio;
    EditState? _edit;
    SearchState? _search;
    MenuState? _menu;
    string? _message;
    bool _focusEdit, _focusSearch, _uiPending;
    CancellationTokenSource? _toastTimer;

    static string Px(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    protected override void OnInitialized()
    {
        _doc = new EditorDocument(Registry);
        _view = new EditorView(_doc, text => _renderer!.MeasureText(text));
        _renderer = new NodeRenderer(_view, _visuals, _images);
        Server.EventReceived += OnServerEvent;
        Browser.EventReceived += OnServerEvent;
        Server.ConnectionChanged += RefreshUi;

        // Blazor only re-renders the toolbar and overlays; the canvas repaints itself. Throttled so a drag does not re-render on every move.
        _doc.Changed += RefreshUi;
        _view.ViewChanged += RefreshUi;
        _view.WidgetActivated += OnWidgetActivated;
        _view.TitleEditRequested += OnTitleEdit;
        _view.SearchRequested += OpenSearch;
        _view.ContextMenuRequested += OnContextMenu;
        _view.Message += ShowMessage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _studio = new StudioCanvas(JS, _canvasRef.As<HTMLCanvasElement>(), _view, _renderer);
            _studio.FirstLayout += () => _view.FitToView();
            _studio.Shortcut += OnShortcut;
            _ = StartServerAsync();
            _dropRef = DotNetObjectReference.Create(this);
            await Interop.InvokeVoidAsync("spawngenEnableDrop", _dropRef, ".stage");
            _studio.CanvasPressed += CloseMenus; // the canvas reports its own presses first, so a menu it opens right after is not closed again
            LoadExample();
            _studio.Focus();
        }
        // The click that opened an overlay is still finishing in the browser, and its default action moves focus to the canvas: focus the
        // overlay's input once that has happened, or typing would go to the canvas.
        if (_focusEdit)
        {
            _focusEdit = false;
            await Task.Delay(40);
            try { await _editRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { } // the editor was closed (a quick pick) before it could take focus
        }
        if (_focusSearch) { _focusSearch = false; await Task.Delay(40); await _searchRef.FocusAsync(); }
    }

    void RefreshUi()
    {
        if (_uiPending) return;
        _uiPending = true;
        _ = Task.Delay(120).ContinueWith(_ => { _uiPending = false; return InvokeAsync(StateHasChanged); });
    }

    Point CenterWorld() => _view.Viewport.ScreenToWorld(new Point(_view.ScreenSize.X / 2, _view.ScreenSize.Y / 2));

    // ---- workflow ----

    void LoadExample()
    {
        _doc.Clear();
        var ids = new Dictionary<string, int>();
        _doc.Group(() =>
        {
            int Add(string key, string type, double x, double y) => ids[key] = _doc.AddNode(type, x, y).Id;
            Add("ckpt", "CheckpointLoaderSimple", 30, 250);
            Add("pos", "CLIPTextEncode", 420, 40);
            Add("neg", "CLIPTextEncode", 420, 300);
            Add("latent", "EmptyLatentImage", 420, 560);
            Add("sampler", "KSampler", 860, 120);
            Add("decode", "VAEDecode", 1230, 120);
            Add("save", "SaveImage", 1230, 240);
            _doc.SetWidget(ids["ckpt"], "ckpt_name", "sd_turbo");
            _doc.SetWidget(ids["pos"], "text", "a photo of a red apple on a wooden table");
            _doc.SetWidget(ids["sampler"], "steps", 1L);
            _doc.SetWidget(ids["sampler"], "cfg", 1.0);
            void C(string from, int o, string to, string input) => _doc.Connect(ids[from], o, ids[to], input, out _);
            C("ckpt", 1, "pos", "clip"); C("ckpt", 1, "neg", "clip");
            C("ckpt", 0, "sampler", "model"); C("pos", 0, "sampler", "positive"); C("neg", 0, "sampler", "negative");
            C("latent", 0, "sampler", "latent_image"); C("sampler", 0, "decode", "samples"); C("ckpt", 2, "decode", "vae");
            C("decode", 0, "save", "images");
        });
        _doc.ClearHistory();
        _view.ClearSelection();
        _view.FitToView();
        _studio?.Focus();
    }

    async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await OpenBytesAsync(e.File.Name, memory.ToArray());
        }
        catch (IOException ex) { ShowMessage($"Could not read {e.File.Name}: {ex.Message}"); }
    }

    /// <summary>A file dropped on the canvas (see <c>spawngenEnableDrop</c> in index.html).</summary>
    [JSInvokable]
    public Task OnFileDropped(string name, byte[] bytes) => OpenBytesAsync(name, bytes);

    /// <summary>
    /// Opens a workflow JSON, an API-format prompt, or a picture generated by ComfyUI or SpawnGen (its PNG carries the workflow, or at least the prompt).
    /// A picture with neither is just a picture: it is offered to Load Image nodes.
    /// </summary>
    async Task OpenBytesAsync(string name, byte[] bytes)
    {
        try
        {
            bool isPng = bytes.Length > 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47;
            string? json = null;
            string source = name;
            if (isPng)
            {
                var text = PngReader.ReadText(bytes);
                if (text.TryGetValue("workflow", out var workflow)) { json = workflow; source = $"the workflow in {name}"; }
                else if (text.TryGetValue("prompt", out var prompt)) { json = prompt; source = $"the prompt in {name} (no editor layout was saved, so it is laid out automatically)"; }
                else
                {
                    if (_engine is null) { ShowMessage($"{name} has no workflow in it, and there is no engine to load it into."); return; }
                    var stored = await _engine.UploadImageAsync(name, bytes);
                    await RefreshInputImagesAsync();
                    ShowMessage(stored is null ? $"{name} has no workflow in it." : $"{name} has no workflow in it, so it was added as an input picture ({stored}).");
                    return;
                }
            }
            else json = System.Text.Encoding.UTF8.GetString(bytes);

            var warnings = ApiPromptImport.Looks(json) ? ApiPromptImport.Load(json, _doc) : ComfyWorkflow.Load(json, _doc);
            _view.ClearSelection();
            _view.FitToView();
            ShowMessage(warnings.Count == 0 ? $"Opened {source}." : $"Opened {source} with {warnings.Count} warning(s): {warnings[0]}");
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
        {
            ShowMessage($"Could not open {name}: {ex.Message}");
        }
    }

    async Task SaveAsync()
    {
        var json = ComfyWorkflow.Save(_doc, _renderer.MeasureText);
        await Interop.InvokeVoidAsync("spawngenDownload", "workflow.json", json);
        ShowMessage("Saved workflow.json.");
    }

    // ---- widget and title editing ----

    void OnWidgetActivated(int nodeId, string name)
    {
        var node = _doc.Graph.GetNode(nodeId);
        var spec = name == ControlAfterGenerate.Name ? ControlAfterGenerate.Spec : Registry.GetSchema(node.ClassType)?.FindInput(name)?.Widget;
        if (spec is null) return;
        var value = node.Widgets.GetValueOrDefault(name) ?? spec.Default;

        if (spec.Kind == WidgetKind.Boolean)
        {
            _doc.SetWidget(nodeId, name, !(value as bool? ?? false));
            _doc.EndGesture();
            return;
        }

        var geo = _view.Hits.Geometry(node);
        var row = geo.Widgets.First(w => w.Name == name).Bounds;
        var topLeft = _view.Viewport.WorldToScreen(new Point(row.X, row.Y));
        var scale = _view.Viewport.Scale;
        _edit = new EditState
        {
            NodeId = nodeId, Name = name, Spec = spec,
            Bounds = new Rect(topLeft.X, topLeft.Y, row.Width * scale, Math.Max(row.Height * scale, 28)),
            Text = Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "",
        };
        _focusEdit = true;
        StateHasChanged();
    }

    void OnTitleEdit(int nodeId)
    {
        var node = _doc.Graph.GetNode(nodeId);
        var geo = _view.Hits.Geometry(node);
        var topLeft = _view.Viewport.WorldToScreen(new Point(geo.TitleBar.X, geo.TitleBar.Y));
        var scale = _view.Viewport.Scale;
        _edit = new EditState
        {
            NodeId = nodeId, Name = null, Spec = null,
            Bounds = new Rect(topLeft.X, topLeft.Y, geo.TitleBar.Width * scale, Math.Max(geo.TitleBar.Height * scale, 28)),
            Text = geo.Title,
        };
        _focusEdit = true;
        StateHasChanged();
    }

    void CommitEdit(string? text)
    {
        if (_edit is not { } e) return;
        _edit = null;
        text ??= "";
        if (e.Name is null)
        {
            _doc.SetTitle(e.NodeId, string.IsNullOrWhiteSpace(text) ? null : text.Trim());
        }
        else if (e.Spec is { } spec)
        {
            object? value = spec.Kind switch
            {
                WidgetKind.Int => long.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var l) ? Clamp(spec, l) : null,
                WidgetKind.Float => double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? Clamp(spec, d) : null,
                _ => text,
            };
            if (value is null) ShowMessage($"'{text}' is not a valid number.");
            else _doc.SetWidget(e.NodeId, e.Name, value);
        }
        _doc.EndGesture();
        _studio?.Focus();
    }

    static object Clamp(WidgetSpec spec, double v)
    {
        if (spec.Min is { } min) v = Math.Max(v, min);
        if (spec.Max is { } max) v = Math.Min(v, max);
        return spec.Kind == WidgetKind.Int ? (object)(long)v : v;
    }

    void EditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _edit?.Spec?.Multiline != true) CommitEdit(_edit?.Text);
        else if (e.Key == "Escape") { _edit = null; _studio?.Focus(); }
    }

    // ---- node search ----

    void OpenSearch(Point world, LinkDraft? draft)
    {
        _search = new SearchState { At = world, Draft = draft };
        _focusSearch = true;
        InvokeAsync(StateHasChanged);
    }

    IEnumerable<NodeSchema> SearchResults()
    {
        var q = _search?.Query.Trim() ?? "";
        var all = Registry.Schemas.OrderBy(s => s.Category).ThenBy(s => s.DisplayName);
        if (q.Length == 0) return all.Take(14);
        var words = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        // Best matches first: the name is the query, starts with it, has a word starting with it, or just contains it.
        int Rank(NodeSchema s) =>
            s.DisplayName.Equals(q, StringComparison.OrdinalIgnoreCase) ? 0
            : s.DisplayName.StartsWith(q, StringComparison.OrdinalIgnoreCase) ? 1
            : s.DisplayName.Split(' ', '(', ')', '_').Any(part => part.StartsWith(q, StringComparison.OrdinalIgnoreCase)) ? 2 : 3;
        return all.Where(s => words.All(w => s.DisplayName.Contains(w, StringComparison.OrdinalIgnoreCase)
                                          || s.Id.Contains(w, StringComparison.OrdinalIgnoreCase)
                                          || s.Category.Contains(w, StringComparison.OrdinalIgnoreCase))).OrderBy(Rank).Take(14);
    }

    void OnSearchInput(ChangeEventArgs e)
    {
        if (_search is not { } s) return;
        s.Query = e.Value?.ToString() ?? "";
        s.Selected = 0;
    }

    void SearchKey(KeyboardEventArgs e)
    {
        if (_search is not { } s) return;
        var results = SearchResults().ToList();
        switch (e.Key)
        {
            case "ArrowDown": s.Selected = Math.Min(s.Selected + 1, Math.Max(results.Count - 1, 0)); break;
            case "ArrowUp": s.Selected = Math.Max(s.Selected - 1, 0); break;
            case "Enter" when results.Count > 0: PlaceFromSearch(results[Math.Min(s.Selected, results.Count - 1)]); break;
            case "Escape": CloseSearch(); break;
        }
    }

    void PlaceFromSearch(NodeSchema schema)
    {
        if (_search is not { } s) return;
        _search = null;
        _view.PlaceNode(schema.Id, s.At, s.Draft);
        _studio?.Focus();
    }

    void CloseSearch()
    {
        _search = null;
        _studio?.Focus();
    }

    // ---- context menu ----

    void OnContextMenu(Hit hit, Point screen)
    {
        var world = _view.Viewport.ScreenToWorld(screen);
        var items = new List<MenuItem>();
        if (hit.Kind is HitKind.NodeBody or HitKind.TitleBar or HitKind.Widget or HitKind.CollapseButton)
        {
            var node = _doc.Graph.GetNode(hit.NodeId);
            items.Add(new("Rename", () => OnTitleEdit(hit.NodeId)));
            if (node.Previews.Count > 0)
                items.Add(new("Save picture", () => _ = SavePicturesAsync(node)));
            items.Add(new(node.Collapsed ? "Expand" : "Collapse", () => { _doc.SetCollapsed(hit.NodeId, !node.Collapsed); _doc.EndGesture(); }));
            items.Add(new(node.Mode == NodeMode.Never ? "Unmute" : "Mute  (Ctrl+M)", () => _view.Key("m", Modifiers.Ctrl)));
            items.Add(new(node.Mode == NodeMode.Bypass ? "Remove bypass" : "Bypass  (Ctrl+B)", () => _view.Key("b", Modifiers.Ctrl)));
            items.Add(new("Copy  (Ctrl+C)", () => _view.Copy()));
            items.Add(new("Delete  (Del)", () => _view.DeleteSelection()));
        }
        else if (hit.Kind == HitKind.Link)
        {
            items.Add(new("Delete link", () => _doc.Disconnect(hit.LinkId)));
        }
        else
        {
            items.Add(new("Add node...", () => OpenSearch(world, null)));
            if (_view.CanPaste) items.Add(new("Paste  (Ctrl+V)", () => _view.Paste(world)));
            items.Add(new("Fit view  (F)", () => _view.FitToView()));
        }
        _menu = new MenuState(screen, items);
        InvokeAsync(StateHasChanged);
    }

    void CloseMenus()
    {
        if (_menu is null) return;
        _menu = null;
        _studio?.Focus();
    }

    // ---- toast ----

    /// <summary>Downloads the pictures a node shows (a browser run keeps results in memory, so this is how they leave the page).</summary>
    async Task SavePicturesAsync(EditorNode node)
    {
        int n = 1;
        foreach (var preview in node.Previews)
            await Interop.InvokeVoidAsync("spawngenDownloadUrl", $"spawngen_{node.Id}_{n++}.png", preview.Url);
    }

    bool OnShortcut(string key, Modifiers mods)
    {
        if (key != "enter" || !mods.HasFlag(Modifiers.Ctrl)) return false;
        _ = QueueAsync();
        return true;
    }

    void ShowMessage(string text)
    {
        _message = text;
        _toastTimer?.Cancel();
        _toastTimer = new CancellationTokenSource();
        var token = _toastTimer.Token;
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(3500, token).ContinueWith(t =>
        {
            if (t.IsCanceled) return Task.CompletedTask;
            _message = null;
            return InvokeAsync(StateHasChanged);
        });
    }

    // ---- running on the server ----

    readonly RunVisuals _visuals = new();
    readonly ImageCache _images = new();
    bool _running;
    int _batchCount = 1;
    int _queueRemaining;
    string? _statusText;
    string? _executingTitle;
    IEngineClient? _engine;
    readonly List<IEngineClient> _engines = [];

    /// <summary>Finds the engines this page can use: a SpawnGen server (when the page was served by one) and this browser's own WebGPU.</summary>
    async Task StartServerAsync()
    {
        if (await Server.ProbeAsync())
        {
            Server.Start();
            _engines.Add(Server); // a native GPU is the faster choice when there is one, so it is the default
        }
        if (Browser.WebGpuAvailable) _engines.Add(Browser);
        _engine = _engines.FirstOrDefault();
        await RefreshInputImagesAsync();
        await InvokeAsync(StateHasChanged);
    }

    async Task OnEngineChosen(ChangeEventArgs e)
    {
        _engine = _engines.FirstOrDefault(x => x.Name == e.Value?.ToString()) ?? _engine;
        await RefreshInputImagesAsync();
        ShowMessage($"Running on: {_engine?.Name}.");
    }

    /// <summary>Load Image offers the pictures of the engine in use; the page shows that engine's list through the shared input store.</summary>
    async Task RefreshInputImagesAsync()
    {
        if (_engine is null) return;
        var names = await _engine.ListInputImagesAsync();
        if (_engine is not BrowserEngine) InputFiles.Store = new ListedInputStore(names); // the server's pictures stay on the server; this is only the choice list
        _view.Invalidate();
    }

    async Task OnUploadChosen(InputFileChangeEventArgs e)
    {
        if (_engine is null) { ShowMessage("There is no engine to upload to."); return; }
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var stored = await _engine.UploadImageAsync(e.File.Name, memory.ToArray());
            await RefreshInputImagesAsync();
            ShowMessage(stored is null ? $"Could not upload {e.File.Name} (only PNG pictures can be loaded)." : $"Uploaded as {stored}: pick it in a Load Image node.");
        }
        catch (IOException ex) { ShowMessage($"Could not read {e.File.Name}: {ex.Message}"); }
    }

    /// <summary>The picture names of a remote engine, shown in Load Image's combo (the pictures themselves are read on that engine).</summary>
    sealed class ListedInputStore(IReadOnlyList<string> names) : IInputStore
    {
        public IReadOnlyList<string> List() => names;
        public Task<byte[]> ReadAsync(string name) => throw new InvalidOperationException("Pictures are read by the engine that runs the graph.");
        public Task<string> SaveAsync(string name, byte[] bytes) => throw new InvalidOperationException("Upload goes through the engine.");
    }

    string RunStatus()
    {
        if (!_running && _queueRemaining == 0) return "";
        var where = _executingTitle is null ? "Queued" : $"Running {_executingTitle}";
        if (_visuals.ProgressMax > 0) where += $" {_visuals.ProgressValue:0}/{_visuals.ProgressMax:0}";
        else if (_statusText is not null) where += $": {_statusText}";
        return where + " · ";
    }

    async Task QueueAsync()
    {
        if (_engine is null) { ShowMessage("There is no engine: this browser has no WebGPU and no SpawnGen server serves this page."); return; }
        for (int run = 0, runs = Math.Clamp(_batchCount, 1, 100); run < runs; run++)
            if (!await QueueOnceAsync()) break;
        _studio?.Focus();
    }

    /// <summary>Sends the graph once and then moves every seed on by its control after generate, as ComfyUI does. False when the run could not be queued.</summary>
    async Task<bool> QueueOnceAsync()
    {
        var compiled = GraphCompiler.Compile(_doc.Graph, Registry);
        if (compiled.Graph.Nodes.Count == 0) { ShowMessage(compiled.Notes.FirstOrDefault() ?? "There is nothing to run."); return false; }
        _visuals.Errors.Clear();

        // The workflow travels with the prompt so Save Image can embed it: the picture can then be dropped back on the canvas.
        var result = await _engine!.QueueAsync(PromptJson.ToJson(compiled.Graph), ComfyWorkflow.Save(_doc, _renderer.MeasureText));
        if (!result.Queued)
        {
            foreach (var (node, message) in result.NodeErrors) _visuals.Errors[node] = message;
            var detail = result.NodeErrors.Count > 0 ? $" {result.NodeErrors.First().Value}" : "";
            ShowMessage($"{result.Message}.{detail}");
            _view.Invalidate();
            return false;
        }
        if (compiled.Notes.Count > 0) ShowMessage(compiled.Notes[0]);
        ControlAfterGenerate.ApplyAfterQueue(_doc, Registry.GetSchema, Random.Shared);
        return true;
    }

    async Task InterruptAsync()
    {
        await (_engine?.InterruptAsync() ?? Task.CompletedTask);
        _studio?.Focus();
    }

    void OnServerEvent(JsonObject e)
    {
        var type = (string?)e["type"];
        var data = e["data"] as JsonObject ?? [];
        int? node = int.TryParse((string?)data["node"], out var n) ? n : null;

        switch (type)
        {
            case "status":
                _queueRemaining = (int?)data["status"]?["exec_info"]?["queue_remaining"] ?? 0;
                break;
            case "execution_start":
                _visuals.BeginRun();
                _running = true;
                _statusText = null;
                break;
            case "executing":
                _visuals.ExecutingNode = node;
                _visuals.ProgressValue = _visuals.ProgressMax = 0;
                _statusText = null;
                _executingTitle = node is { } runningId && _doc.Graph.FindNode(runningId) is { } running
                    ? running.Title ?? Registry.GetSchema(running.ClassType)?.DisplayName ?? running.ClassType : null;
                break;
            case "progress":
                _visuals.ProgressValue = (double?)data["value"] ?? 0;
                _visuals.ProgressMax = (double?)data["max"] ?? 0;
                break;
            case "node_status":
                _statusText = (string?)data["message"];
                break;
            case "executed" when node is { } shownId && _doc.Graph.FindNode(shownId) is { } shown:
                if (data["output"]?["images"] is JsonArray images)
                    shown.Previews = images.OfType<JsonObject>()
                        .Select(i => new NodePreview(_engine!.ViewUrl((string)i["filename"]!, (string?)i["subfolder"], (string?)i["type"]))).ToList();
                break;
            case "execution_error":
                int? failedNode = node;
                if (failedNode is null && int.TryParse((string?)data["node_id"], out var failedId)) failedNode = failedId;
                if (failedNode is { } badId) _visuals.Errors[badId] = (string?)data["exception_message"] ?? "failed";
                ShowMessage($"Run failed: {(string?)data["exception_message"]}");
                _running = false;
                _visuals.EndRun();
                break;
            case "execution_success":
                _running = false;
                _executingTitle = null;
                _visuals.EndRun();
                break;
            case "execution_interrupted":
                _running = false;
                _executingTitle = null;
                _visuals.EndRun();
                ShowMessage("Stopped.");
                break;
        }
        _view.Invalidate();
        RefreshUi();
    }

    DotNetObjectReference<Studio>? _dropRef;

    public void Dispose()
    {
        Server.EventReceived -= OnServerEvent;
        Browser.EventReceived -= OnServerEvent;
        Server.ConnectionChanged -= RefreshUi;
        _images.Dispose();
        _dropRef?.Dispose();
        _studio?.Dispose();
        _toastTimer?.Cancel();
    }
}
