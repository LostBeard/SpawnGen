    /// <summary>Paints a mask over the picture of a Load Image node: the result is a new picture whose painted pixels are transparent, which the node turns into its mask.</summary>
    async Task OpenMaskEditorAsync(EditorNode node)
    {
        if (_engine is null) { ShowMessage("There is no engine to keep the masked picture on."); return; }
        if (node.Widgets.GetValueOrDefault("image") as string is not { Length: > 0 } name) { ShowMessage("Pick a picture in the Load Image node first."); return; }
        try
        {
            var png = await Interop.InvokeAsync<byte[]?>("spawngenMaskEditor", _engine.ViewUrl(name, "", "input"));
            if (png is null) return;
            var stem = System.IO.Path.GetFileNameWithoutExtension(name);
            var stored = await _engine.UploadImageAsync(stem.StartsWith("mask-") ? stem + ".png" : $"mask-{stem}.png", png);
            if (stored is null) { ShowMessage("Could not keep the masked picture."); return; }
            await RefreshInputImagesAsync();
            _doc.SetWidget(node.Id, "image", stored);
            _doc.EndGesture();
            ShowMessage($"Saved as {stored}: its painted area is the node's mask output.");
        }
        catch (Microsoft.JSInterop.JSException ex) { ShowMessage("The mask editor failed: " + ex.Message); }
    }

    // ---- models ----

    bool _modelsOpen, _polling;
    SpawnGen.Runtime.ModelCacheInfo? _cache;
    string? _downloadText;
    SpawnGen.Runtime.ModelDownload? _download;

    static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.0} GB",
        >= 1L << 20 => $"{bytes / (double)(1L << 20):0} MB",
        >= 1L << 10 => $"{bytes / 1024.0:0} KB",
        _ => $"{bytes} B",
    };

    /// <summary>Cache keys look like hf_owner_repo_main_path_to_file; show them without the plumbing.</summary>
    static string ShortKey(string key)
    {
        var k = key.StartsWith("hf_", StringComparison.Ordinal) ? key[3..] : key;
        return k.Replace("_main_", " / ", StringComparison.Ordinal);
    }

    void ToggleModels()
    {
        _modelsOpen = !_modelsOpen;
        if (_modelsOpen) { _cache = null; _ = PollModelsAsync(); }
        _studio?.Focus();
    }

    /// <summary>Reads the model cache once a second while the panel is open or a run is going (to show downloads in the status line).</summary>
    async Task PollModelsAsync()
    {
        if (_polling) return;
        _polling = true;
        try
        {
            while ((_modelsOpen || _running) && _engine is not null)
            {
                _cache = await _engine.GetModelCacheAsync();
                var d = _download = _cache.Downloads.FirstOrDefault();
                _downloadText = d is null ? null : DownloadText(d, _cache.Downloads.Count);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { }
        finally { _polling = false; _downloadText = null; _download = null; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>"Downloading unet / model.onnx: 412 MB of 1.6 GB, 5.1 MB/s" (plus how many other files are downloading).</summary>
    static string DownloadText(SpawnGen.Runtime.ModelDownload d, int count)
    {
        var name = ShortKey(d.Key);
        name = name[(name.LastIndexOf(" / ", StringComparison.Ordinal) is var cut and >= 0 ? cut + 3 : 0)..]; // the file; the Models panel shows the repo
        var text = $"Downloading {name}: {FormatBytes(d.Received)}{(d.Total > 0 ? $" of {FormatBytes(d.Total)}" : "")}";
        if (d.BytesPerSecond > 0) text += $", {FormatBytes((long)d.BytesPerSecond)}/s";
        if (count > 1) text += $" (+{count - 1} more)";
        return text;
    }

    /// <summary>How far the run is, for the status bar: the download in progress, else the running node's steps; null when neither is known.</summary>
    double? RunFraction()
    {
        if (_download?.Fraction is { } downloaded) return downloaded;
        if (_visuals.ProgressMax > 0) return _visuals.Fraction;
        // A loader's own stage text ("Loading sd_turbo: unet:parse 40%").
        if (_statusText is { } text && System.Text.RegularExpressions.Regex.Match(text, @"(\d{1,3})%$") is { Success: true } m) return Math.Min(int.Parse(m.Groups[1].Value), 100) / 100.0;
        return null;
    }

