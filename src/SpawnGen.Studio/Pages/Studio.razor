@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnGen.Editor
@using System.Text.Json.Nodes
@using System.Net.Http.Json
@using SpawnGen.Engine.Graph
@using SpawnGen.Studio.Run
@using SpawnGen.Nodes.Core
@using SpawnGen.Engine.Nodes
@using SpawnGen.Studio.Canvas
@inject SpawnJSRuntime JS
@inject IJSRuntime Interop
@inject NodeRegistry Registry
@inject ServerClient Server
@inject BrowserEngine Browser
@inject HttpClient Http
@implements IDisposable

<div class="studio">
    <div class="toolbar" @onpointerdown="CloseMenus">
        <span class="brand">SpawnGen</span>
        <button title="Undo (Ctrl+Z)" disabled="@(!_doc.CanUndo)" @onclick="() => { _doc.Undo(); _studio?.Focus(); }">Undo</button>
        <button title="Redo (Ctrl+Y)" disabled="@(!_doc.CanRedo)" @onclick="() => { _doc.Redo(); _studio?.Focus(); }">Redo</button>
        <span class="sep"></span>
        <button class="@(_libraryOpen ? "on" : "")" title="Node library: browse every node by category, click or drag one onto the canvas (N)" @onclick="() => { ToggleLibrary(); }">Nodes</button>
        <button class="@(_historyOpen ? "on" : "")" title="Queue and history: every run of this session with its pictures; load the workflow of a run back (H)" @onclick="ToggleHistory">History@(_history.Count > 0 ? $" ({_history.Count})" : "")</button>
        <button class="@(_propsOpen ? "on" : "")" title="Properties of the selected node: title, mode, colour, every parameter and where its inputs come from (I)" @onclick="ToggleProperties">Properties</button>
        <button class="@(_modelsOpen ? "on" : "")" title="Models: what this engine has downloaded, what is downloading, free the space" @onclick="ToggleModels">Models</button>
        <button class="@(_settingsOpen ? "on" : "")" title="Settings: how links are drawn, snap to grid, minimap" @onclick="() => { _settingsOpen = !_settingsOpen; _studio?.Focus(); }">Settings</button>
        <button class="@(_settings.ShowMinimap ? "on" : "")" title="Overview of the whole graph in the corner: click or drag on it to move the view" @onclick="() => { _settings.ShowMinimap = !_settings.ShowMinimap; ApplySettings(); _studio?.Focus(); }">Map</button>
        <button title="Fit all nodes in view (F)" @onclick="() => { _view.FitToView(); _studio?.Focus(); }">Fit</button>
        <button class="@(_appView != AppView.Graph ? "on" : "")" title="App mode: run this workflow from a simple form of the inputs and outputs you chose, without the node graph (the App Builder sets them up)" @onclick="ToggleAppMode">App</button>
        <span class="sep"></span>
        <label class="button" title="Open a workflow: a ComfyUI .json (workflow or API format) or a picture generated by ComfyUI or SpawnGen. You can also drop the file on the canvas.">Open<InputFile @key="_fileInputs" OnChange="OnFileChosenAsync" accept=".json,.png" hidden /></label>
        <button class="@(_workflowsOpen ? "on" : "")" title="Workflows: the open tabs and the saved workflows and apps (W)" @onclick="() => ToggleWorkflowsAsync(false)">Workflows</button>
        <button title="Save the workflow in the workflow library (Ctrl+S)" @onclick="SaveToLibraryAsync">Save</button>
        <button title="Download the workflow as a ComfyUI JSON file" @onclick="ExportAsync">Export</button>
        <button title="Example workflows: text to image, image to image, inpainting, FLUX, speech ..." @onclick="OpenExamples">Examples</button>
        <button class="@(_templatesOpen ? "on" : "")" title="ComfyUI's workflow templates (Comfy-Org, MIT): browse, search, open one in a new tab" @onclick="OpenTemplatesAsync">Templates</button>
        <span class="sep"></span>
        @if (_running)
        {
            <button class="danger" title="Stop the run in progress" @onclick="InterruptAsync">Stop</button>
        }
        <button class="primary" disabled="@(_engine is null)" @onclick="() => QueueAsync()"
                title="@(_engine is null ? "No engine: this browser has no WebGPU and there is no SpawnGen server." : $"Run the graph on: {_engine.Name} (Ctrl+Enter)")">
            <span>Queue</span>
            @if (_pending.Count > 0)
            {
                <span class="count" title="Runs waiting in the queue">@_pending.Count</span>
            }
        </button>
        @if (_running)
        {
            <button title="Put the graph at the front of the queue so it runs next (Ctrl+Shift+Enter)" @onclick="() => QueueAsync(front: true)">Front</button>
        }
        <select class="engine" title="Where graphs run" @onchange="OnEngineChosen">
            @foreach (var engine in _engines)
            {
                <option value="@engine.Name" selected="@(ReferenceEquals(engine, _engine))">@engine.Name</option>
            }
            @if (_engines.Count == 0)
            {
                <option>No engine available</option>
            }
        </select>
        <label class="button" title="Upload a PNG, JPEG, WebP, GIF or BMP for Load Image nodes, a WAV or FLAC for Load Audio, or a .latent for Load Latent">Upload<InputFile @key="_fileInputs" OnChange="OnUploadChosenAsync" accept=".png,.jpg,.jpeg,.webp,.gif,.bmp,.wav,.flac,.latent" hidden /></label>
        <label class="check" title="Batch count: how many times Queue runs the graph (each run uses the next seed per the seed widget's control after generate)">batch <input class="batch" type="number" min="1" max="100" step="1" @bind="_batchCount" @bind:event="oninput" /></label>
    </div>

    <div class="tabs" @onpointerdown="CloseMenus">
        @foreach (var tab in _tabs.Tabs)
        {
            var current = tab;
            <div class="tab @(current.Id == _tabs.ActiveId ? "active" : "")" title="Double-click to rename" @onclick="() => SwitchTab(current.Id)" @ondblclick="() => _renamingTab = current.Id">
                @if (_renamingTab == current.Id)
                {
                    <input value="@current.Name" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true"
                           @onchange="e => { RenameTab(current.Id, e.Value?.ToString()); }" @onblur="() => _renamingTab = null"
                           @onkeydown="RenameKey" />
                }
                else
                {
                    <span>@current.Name</span>
                }
                <button title="Close this workflow" @onclick="() => CloseTab(current.Id)" @onclick:stopPropagation="true">&times;</button>
            </div>
        }
        <button class="newtab" title="A new workflow in a new tab" @onclick="NewTab">+</button>
    </div>

    <div class="stage">
        <canvas @ref="_canvasRef" tabindex="0"></canvas>

        @if (_appView == AppView.Builder)
        {
            <div class="app-steps">
                <span class="app-steps-title">App Builder</span>
                @for (int i = 0; i < BuilderSteps.Length; i++)
                {
                    var step = i;
                    <button class="@StepClass(step)" @onclick="() => BuilderGo(step)"><b>@(step + 1)</b> @BuilderSteps[step]</button>
                }
            </div>
            @if (_builderStep <= 1)
            {
                var picking = _builderStep == 0;
                <div class="app-picks">
                    <div class="set-head"><span>@(picking ? "Select inputs" : "Select outputs")</span></div>
                    <div class="app-hint">@(picking ? InputsHint : OutputsHint)</div>
                    <div class="app-pick-list">
                        @if (picking)
                        {
                            @for (int i = 0; i < _app.Inputs.Count; i++)
                            {
                                var index = i;
                                <div class="app-pick"><b>@(index + 1)</b><span>@InputLabel(_app.Inputs[index])</span>
                                    <button title="Earlier" @onclick="() => MoveAppInput(index, -1)">&uarr;</button><button title="Later" @onclick="() => MoveAppInput(index, 1)">&darr;</button><button title="Take out" @onclick="() => RemoveAppInput(index)">&times;</button></div>
                            }
                            @if (_app.Inputs.Count == 0)
                            {
                                <div class="hist-none">No inputs yet.</div>
                            }
                        }
                        else
                        {
                            @for (int i = 0; i < _app.Outputs.Count; i++)
                            {
                                var index = i;
                                <div class="app-pick"><b>@(index + 1)</b><span>@OutputLabel(_app.Outputs[index])</span>
                                    <button title="Earlier" @onclick="() => MoveAppOutput(index, -1)">&uarr;</button><button title="Later" @onclick="() => MoveAppOutput(index, 1)">&darr;</button><button title="Take out" @onclick="() => RemoveAppOutput(index)">&times;</button></div>
                            }
                            @if (_app.Outputs.Count == 0)
                            {
                                <div class="hist-none">No outputs chosen: the app shows every result.</div>
                            }
                        }
                    </div>
                </div>
            }
            else if (_builderStep == 2)
            {
                @AppPage(true)
            }
            else
            {
                <div class="app-default">
                    <h3>Set a default view</h3>
                    <p>How this workflow opens, here and in ComfyUI.</p>
                    <label class="row"><input type="radio" name="app-default" checked="@_builderOpensAsApp" @onchange="() => _builderOpensAsApp = true" /> App</label>
                    <label class="row"><input type="radio" name="app-default" checked="@(!_builderOpensAsApp)" @onchange="() => _builderOpensAsApp = false" /> Node graph</label>
                    <button class="primary" @onclick="ApplyApp">Apply</button>
                </div>
            }
            <div class="app-builder-bar">
                <button title="Leave the builder (nothing is saved until Apply)" @onclick="ExitAppMode">Exit</button>
                <span class="grow"></span>
                <button disabled="@(_builderStep == 0)" @onclick="() => BuilderGo(_builderStep - 1)">Back</button>
                @if (_builderStep < BuilderSteps.Length - 1)
                {
                    <button class="primary" @onclick="() => BuilderGo(_builderStep + 1)">Next</button>
                }
            </div>
        }
        else if (_appView == AppView.App)
        {
            @AppPage(false)
        }

        @if (_subgraphStack.Count > 0)
        {
            <div class="crumbs" title="Inside a subgraph: edits change every use of it. Click a name to go back out.">
                @for (int i = 0; i < _subgraphStack.Count; i++)
                {
                    var level = i;
                    <button @onclick="() => ExitSubgraphTo(level)">@(level == 0 ? _tabs.Active?.Name ?? "Workflow" : _subgraphStack[level].Name)</button>
                    <span>›</span>
                }
                <b>@(SubgraphLibrary.Get(SubgraphEditing.EditedId(_doc) ?? "")?.Name ?? "Subgraph")</b>
            </div>
        }

        @if (_workflowsOpen)
        {
            var shown = SavedShown().ToList();
            <div class="library workflows">
                <div class="wf-tabs">
                    <button class="@(!_appsTab ? "on" : "")" @onclick="() => ToggleWorkflowsAsync(false)">Workflows</button>
                    <button class="@(_appsTab ? "on" : "")" @onclick="() => ToggleWorkflowsAsync(true)">Apps</button>
                </div>
                <input class="lib-filter" placeholder="@(_appsTab ? "Search apps..." : "Search workflows...")" value="@_workflowFilter" @oninput="OnWorkflowFilter" />
                <div class="lib-list">
                    @if (_appsTab)
                    {
                        <button class="wf-create" title="Turn the workflow in front into an app: the App Builder picks its inputs and outputs" @onclick="CreateApp">+ Create app</button>
                    }
                    else
                    {
                        <div class="lib-cat">Open</div>
                        @foreach (var tab in _tabs.Tabs)
                        {
                            var t = tab;
                            <div class="wf-item @(t.Id == _tabs.ActiveId ? "active" : "")" title="@(t.Path ?? "Not saved in the library")" @onclick="() => SwitchTab(t.Id)">
                                <span>@t.Name</span>
                                @if (t.Path is null)
                                {
                                    <small>not saved</small>
                                }
                            </div>
                        }
                    }
                    <div class="lib-cat">@(_appsTab ? "Apps" : "Saved") <span>@shown.Count</span></div>
                    @foreach (var entry in shown)
                    {
                        var item = entry;
                        if (_renamingPath == item.Path)
                        {
                            <input class="wf-rename" @bind="_renameText" @bind:event="oninput" @onkeydown="k => OnRenameSavedKey(k, item)" @onblur="() => CommitRenameAsync(item)" @ref="_renameRef" />
                        }
                        else if (_deletingPath == item.Path)
                        {
                            <div class="wf-item confirm">
                                <span>Delete @item.Name?</span>
                                <button class="danger" @onclick="() => DeleteSavedAsync(item)">Delete</button>
                                <button @onclick="() => _deletingPath = null">Keep</button>
                            </div>
                        }
                        else
                        {
                            <div class="wf-item" title="@SavedTitle(item)" @onclick="() => OpenSavedAsync(item)">
                                @if (item.IsApp && !_appsTab)
                                {
                                    <b class="wf-app">app</b>
                                }
                                <span>@item.Name</span>
                                <small>@Ago(item.Modified)</small>
                                <button title="Rename" @onclick="() => StartRenameSaved(item)" @onclick:stopPropagation="true">&#x270E;</button>
                                <button title="Delete" @onclick="() => _deletingPath = item.Path" @onclick:stopPropagation="true">&times;</button>
                            </div>
                        }
                    }
                    @if (shown.Count == 0)
                    {
                        <div class="app-hint">@EmptyLibraryText()</div>
                    }
                </div>
                <div class="wf-foot">
                    <button @onclick="SaveToLibraryAsync">Save</button>
                    <button @onclick="() => OpenSaveDialog(true)">Save as...</button>
                    <span>Saved @Store.Where</span>
                </div>
            </div>
        }

        @if (_saveDialog is { } dialog)
        {
            <div class="modal-back" @onclick="() => _saveDialog = null">
                <div class="save-dialog" @onclick:stopPropagation="true">
                    <h3>@(dialog.Copy ? "Save as" : "Save workflow")</h3>
                    <p>Saved @Store.Where. A / in the name puts it in a folder.</p>
                    <input @bind="dialog.Name" @bind:event="oninput" @onkeydown="OnSaveDialogKey" @ref="_saveNameRef" />
                    @if (dialog.Replaces is { } replaces)
                    {
                        <p class="warn">@WorkflowLibrary.DisplayName(replaces) is already saved. Replace it?</p>
                    }
                    <div class="row">
                        <button @onclick="() => _saveDialog = null">Cancel</button>
                        <button class="primary" @onclick="ConfirmSaveAsync">@(dialog.Replaces is null ? "Save" : "Replace")</button>
                    </div>
                </div>
            </div>
        }

        @if (_libraryOpen)
        {
            <div class="library">
                <input class="lib-filter" placeholder="Filter nodes..." value="@_libraryFilter" @oninput="OnLibraryFilter" />
                <div class="lib-list">
                    @foreach (var group in LibraryGroups())
                    {
                        var open = _libraryFilter.Trim().Length > 0 || !_libraryClosed.Contains(group.Key);
                        var key = group.Key;
                        <div class="lib-cat" @onclick="() => ToggleCategory(key)">@(open ? "▾" : "▸") @key.Replace("/", " › ") <span>@group.Count()</span></div>
                        @if (open)
                        {
                            @foreach (var schema in group)
                            {
                                var item = schema;
                                <div class="lib-node" draggable="true" data-node="@item.Id" title="@item.Id" @onclick="() => PlaceFromLibrary(item)">@item.DisplayName</div>
                            }
                        }
                    }
                </div>
            </div>
        }

        @if (_propsOpen)
        {
            <PropertiesPanel Doc="_doc" View="_view" BesideHistory="_historyOpen" Message="ShowMessage" OnClose="ToggleProperties" />
        }

        @if (_historyOpen)
        {
            <div class="history">
                <div class="hist-head">
                    <span>@(_running ? "Running" : "Idle")@(_pending.Count > 0 ? $", {_pending.Count} queued" : "")</span>
                    <button title="Forget the runs listed here (the pictures stay where they were saved)" disabled="@(_history.Count == 0)" @onclick="ClearHistory">Clear</button>
                </div>
                <div class="hist-list">
                    @foreach (var waiting in _pending)
                    {
                        var queued = waiting;
                        <div class="hist-entry queued">
                            <div class="hist-title">Queued · @queued.At.ToString("HH:mm:ss")</div>
                            <div class="hist-engine">@queued.Engine</div>
                            <div class="hist-actions">
                                <button title="Take this run out of the queue" @onclick="() => CancelQueuedAsync(queued)">Cancel</button>
                            </div>
                        </div>
                    }
                    @foreach (var entry in _history)
                    {
                        var run = entry;
                        <div class="hist-entry @run.State">
                            <div class="hist-title">#@run.Number · @(run.Past && run.Started.Date != DateTime.Today ? run.Started.ToString("yyyy-MM-dd HH:mm:ss") : run.Started.ToString("HH:mm:ss"))@(run.Seconds is { } sec ? $" · {sec:0.#} s" : "") · @run.State@(run.Past ? " · earlier" : "")</div>
                            <div class="hist-engine">@run.Engine</div>
                            @if (run.Error is not null)
                            {
                                <div class="hist-error">@run.Error</div>
                            }
                            @if (run.Note is not null)
                            {
                                <div class="hist-note">@run.Note</div>
                            }
                            @foreach (var sound in run.Audio)
                            {
                                <audio controls src="@sound"></audio>
                            }
                            @foreach (var model in run.Models)
                            {
                                var m3d = model;
                                <div class="hist-actions"><button title="Open the model in the 3D viewer" @onclick="() => View3D(m3d)">View 3D model</button></div>
                            }
                            <div class="hist-thumbs">
                                @foreach (var url in run.Urls)
                                {
                                    var picture = url;
                                    <img src="@picture" alt="result" @onclick="() => _lightbox = picture" />
                                }
                            </div>
                            <div class="hist-actions">
                                <button title="Open this run's workflow in a new tab" @onclick="() => LoadRunWorkflow(run)">Load workflow</button>
                            </div>
                        </div>
                    }
                    @if (_history.Count == 0)
                    {
                        <div class="hist-none">Nothing has run yet. Press Queue.</div>
                    }
                </div>
            </div>
        }

        @if (_settingsOpen)
        {
            <div class="settings">
                <div class="set-head"><span>Settings</span><button title="Close" @onclick="() => _settingsOpen = false">&times;</button></div>
                <label>Colour palette
                    <select @onchange="OnPaletteChosen">
                        @foreach (var palette in Theme.All)
                        {
                            <option value="@palette.Id" selected="@(palette.Id == Theme.Current.Id)">@palette.Name</option>
                        }
                    </select>
                </label>
                <label>Link style
                    <select @onchange="OnLinkStyleChosen">
                        @foreach (var style in Enum.GetValues<LinkStyle>())
                        {
                            <option value="@((int)style)" selected="@(style == _settings.LinkStyle)">@style</option>
                        }
                    </select>
                </label>
                <label class="row"><input type="checkbox" checked="@_settings.SnapToGrid" @onchange="e => { _settings.SnapToGrid = (bool)(e.Value ?? false); ApplySettings(); }" /> Snap nodes to the grid</label>
                <label>Grid size
                    <input type="number" min="2" max="200" step="1" value="@_settings.GridSize" @onchange="OnGridSizeChosen" />
                </label>
                <label class="row"><input type="checkbox" checked="@_settings.ShowNodeIds" @onchange="e => { _settings.ShowNodeIds = (bool)(e.Value ?? false); ApplySettings(); }" /> Show node ids (#12) in the title bars</label>
                <label class="row"><input type="checkbox" checked="@_settings.ShowMinimap" @onchange="e => { _settings.ShowMinimap = (bool)(e.Value ?? false); ApplySettings(); }" /> Show the minimap</label>
                <button class="set-button" title="Every keyboard shortcut; change, remove or reset them (Ctrl+Shift+K)" @onclick="ToggleShortcuts">Keyboard shortcuts...</button>
                <label title="How samplers preview while they work: latent2rgb is a quick colour guess; taesd runs the tiny VAE (taesd_decoder / taesdxl_decoder in models/vae_approx) and looks close to the final picture">Sampler preview
                    <select @onchange="OnPreviewMethodChosen">
                        @foreach (var method in StudioSettings.PreviewMethods)
                        {
                            <option value="@method" selected="@(method == _settings.PreviewMethod)">@method</option>
                        }
                    </select>
                </label>
            </div>
        }

        @if (_templateDialog is { } templateDialog)
        {
            <div class="modal-back" @onclick="() => _templateDialog = null">
                <div class="save-dialog" @onclick:stopPropagation="true">
                    <h3>Save as template</h3>
                    <p>@templateDialog.Ids.Length node(s) and the links among them, kept @Store.Where; insert them from the canvas menu's Node Templates.</p>
                    <input placeholder="Template name" value="@templateDialog.Name" @oninput="OnTemplateNameInput" @onkeydown="OnTemplateNameKey" @ref="_templateNameRef" />
                    @if (templateDialog.Replace)
                    {
                        <p class="warn">There is a template named @templateDialog.Name.Trim(). Replace it?</p>
                    }
                    <div class="row">
                        <button @onclick="() => _templateDialog = null">Cancel</button>
                        <button class="primary" @onclick="ConfirmTemplateAsync">@(templateDialog.Replace ? "Replace" : "Save")</button>
                    </div>
                </div>
            </div>
        }

        @if (_templatesManageOpen)
        {
            <div class="modal-back" @onclick="() => _templatesManageOpen = false">
                <div class="save-dialog templates-manage" @onclick:stopPropagation="true">
                    <h3>Node templates</h3>
                    <p>Kept @Store.Where. Rename a template by editing its name.</p>
                    <div class="tpl-list">
                        @for (int i = 0; i < _nodeTemplates.Count; i++)
                        {
                            var index = i;
                            var template = _nodeTemplates[i];
                            <div class="tpl-row">
                                <input value="@template.Name" @onchange="e => RenameTemplateAsync(index, e.Value?.ToString())" />
                                <button title="Delete this template" @onclick="() => DeleteTemplateAsync(index)">&times;</button>
                            </div>
                        }
                        @if (_nodeTemplates.Count == 0)
                        {
                            <p>No templates yet: select nodes, then the canvas menu's Save Selected as Template.</p>
                        }
                    </div>
                    <div class="row">
                        <label class="button" title="Add the templates of a comfy.templates.json file">Import<InputFile @key="_fileInputs" OnChange="OnTemplatesImportAsync" accept=".json" hidden /></label>
                        <button disabled="@(_nodeTemplates.Count == 0)" title="Download every template as comfy.templates.json" @onclick="ExportTemplatesAsync">Export</button>
                        <span class="grow"></span>
                        <button class="primary" @onclick="() => _templatesManageOpen = false">Close</button>
                    </div>
                </div>
            </div>
        }

        @if (_shortcutsOpen)
        {
            <div class="modal-back" @onclick="ToggleShortcuts">
                <div class="shortcuts" @onclick:stopPropagation="true">
                    <div class="set-head"><span>Keyboard shortcuts</span><button title="Close" @onclick="ToggleShortcuts">&times;</button></div>
                    <input class="sc-filter" placeholder="Search shortcuts..." value="@_shortcutFilter" @oninput="OnShortcutFilter" />
                    <div class="sc-list">
                        @foreach (var c in ShortcutsShown())
                        {
                            var command = c;
                            var keys = _bindings.Keys(command.Id);
                            bool changed = _bindings.IsChanged(command.Id);
                            <div class="sc-row @(changed ? "changed" : "")">
                                <span class="sc-name">@command.Label</span>
                                @if (_capturing == command.Id)
                                {
                                    <button class="sc-keys capturing" @ref="_captureRef" @onkeydown="e => OnCaptureKey(e, command.Id)" @onkeydown:preventDefault="true"
                                            @onblur="() => _capturing = null">Press keys...</button>
                                }
                                else
                                {
                                    <button class="sc-keys" title="Change: click, then press the new keys" @onclick="() => StartCapture(command.Id)">
                                        @if (keys.Count == 0)
                                        {
                                            <span class="sc-none">none</span>
                                        }
                                        @foreach (var k in keys)
                                        {
                                            <kbd>@k</kbd>
                                        }
                                    </button>
                                }
                                <button class="sc-act" title="No keys for this command" disabled="@(keys.Count == 0)" @onclick="() => UnbindShortcut(command.Id)">&times;</button>
                                <button class="sc-act" title="Back to the default keys" disabled="@(!changed)" @onclick="() => ResetShortcut(command.Id)">&#x21BA;</button>
                            </div>
                        }
                    </div>
                    <div class="sc-foot"><span>@_shortcutNote</span><button @onclick="ResetAllShortcuts">Reset all</button></div>
                </div>
            </div>
        }

        @if (_modelsOpen)
        {
            <div class="models">
                <div class="set-head"><span>Models on @(_engine?.Name ?? "this engine")</span><button title="Close" @onclick="() => _modelsOpen = false">&times;</button></div>
                @if (_cache is null)
                {
                    <div class="hist-none">Reading...</div>
                }
                else
                {
                    @foreach (var d in _cache.Downloads)
                    {
                        <div class="model-download">
                            <div>@ShortKey(d.Key)</div>
                            <div class="bar"><div style="width:@((int)((d.Fraction ?? 0) * 100))%"></div></div>
