@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnGen.Editor
@using System.Text.Json.Nodes
@using SpawnGen.Engine.Graph
@using SpawnGen.Studio.Run
@using SpawnGen.Nodes.Core
@using SpawnGen.Engine.Nodes
@using SpawnGen.Studio.Canvas
@inject SpawnJSRuntime JS
@inject IJSRuntime Interop
@inject NodeRegistry Registry
@inject ServerClient Server
@inject BrowserEngine Browser
@implements IDisposable

<div class="studio">
    <div class="toolbar" @onpointerdown="CloseMenus">
        <span class="brand">SpawnGen</span>
        <button title="Undo (Ctrl+Z)" disabled="@(!_doc.CanUndo)" @onclick="() => { _doc.Undo(); _studio?.Focus(); }">Undo</button>
        <button title="Redo (Ctrl+Y)" disabled="@(!_doc.CanRedo)" @onclick="() => { _doc.Redo(); _studio?.Focus(); }">Redo</button>
        <span class="sep"></span>
        <button class="@(_libraryOpen ? "on" : "")" title="Node library: browse every node by category, click or drag one onto the canvas (N)" @onclick="() => { ToggleLibrary(); }">Nodes</button>
        <button class="@(_historyOpen ? "on" : "")" title="Queue and history: every run of this session with its pictures; load the workflow of a run back (H)" @onclick="ToggleHistory">History@(_history.Count > 0 ? $" ({_history.Count})" : "")</button>
        <button class="@(_settingsOpen ? "on" : "")" title="Settings: how links are drawn, snap to grid, minimap" @onclick="() => { _settingsOpen = !_settingsOpen; _studio?.Focus(); }">Settings</button>
        <button title="Add a node (double-click the canvas)" @onclick="() => OpenSearch(CenterWorld(), null)">Add node</button>
        <button class="@(_settings.ShowMinimap ? "on" : "")" title="Overview of the whole graph in the corner: click or drag on it to move the view" @onclick="() => { _settings.ShowMinimap = !_settings.ShowMinimap; ApplySettings(); _studio?.Focus(); }">Map</button>
        <button title="Fit all nodes in view (F)" @onclick="() => { _view.FitToView(); _studio?.Focus(); }">Fit</button>
        <span class="sep"></span>
        <label class="button" title="Open a workflow: a ComfyUI .json (workflow or API format) or a picture generated by ComfyUI or SpawnGen. You can also drop the file on the canvas.">Open<InputFile OnChange="OnFileChosen" accept=".json,.png" hidden /></label>
        <button title="Download the workflow as ComfyUI JSON" @onclick="SaveAsync">Save</button>
        <button title="Replace the graph with a starter text-to-image workflow" @onclick="LoadExample">Example</button>
        <span class="sep"></span>
        @if (_running)
        {
            <button class="danger" title="Stop the run in progress" @onclick="InterruptAsync">Stop</button>
        }
        else
        {
            <button class="primary" disabled="@(_engine is null)" @onclick="QueueAsync"
                    title="@(_engine is null ? "No engine: this browser has no WebGPU and there is no SpawnGen server." : $"Run the graph on: {_engine.Name} (Ctrl+Enter)")">Queue</button>
        }
        <select class="engine" title="Where graphs run" @onchange="OnEngineChosen">
            @foreach (var engine in _engines)
            {
                <option value="@engine.Name" selected="@(ReferenceEquals(engine, _engine))">@engine.Name</option>
            }
            @if (_engines.Count == 0)
            {
                <option>No engine available</option>
            }
        </select>
        <label class="button" title="Upload a PNG or JPEG for Load Image nodes, or a WAV for Load Audio">Upload<InputFile OnChange="OnUploadChosen" accept=".png,.jpg,.jpeg,.wav" hidden /></label>
        <label class="check" title="Batch count: how many times Queue runs the graph (each run uses the next seed per the seed widget's control after generate)">batch <input class="batch" type="number" min="1" max="100" step="1" @bind="_batchCount" @bind:event="oninput" /></label>
        <span class="status">@RunStatus()@_doc.Graph.Nodes.Count nodes, @_doc.Graph.Links.Count links, @((int)Math.Round(_view.Viewport.Scale * 100))%</span>
    </div>

    <div class="tabs" @onpointerdown="CloseMenus">
        @foreach (var tab in _tabs.Tabs)
        {
            var current = tab;
            <div class="tab @(current.Id == _tabs.ActiveId ? "active" : "")" title="Double-click to rename" @onclick="() => SwitchTab(current.Id)" @ondblclick="() => _renamingTab = current.Id">
                @if (_renamingTab == current.Id)
                {
                    <input value="@current.Name" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true"
                           @onchange="e => { RenameTab(current.Id, e.Value?.ToString()); }" @onblur="() => _renamingTab = null"
                           @onkeydown="RenameKey" />
                }
                else
                {
                    <span>@current.Name</span>
                }
                <button title="Close this workflow" @onclick="() => CloseTab(current.Id)" @onclick:stopPropagation="true">&times;</button>
            </div>
        }
        <button class="newtab" title="A new workflow in a new tab" @onclick="NewTab">+</button>
    </div>

    <div class="stage">
        <canvas @ref="_canvasRef" tabindex="0"></canvas>

        @if (_libraryOpen)
        {
            <div class="library">
                <input class="lib-filter" placeholder="Filter nodes..." value="@_libraryFilter" @oninput="OnLibraryFilter" />
                <div class="lib-list">
                    @foreach (var group in LibraryGroups())
                    {
                        var open = _libraryFilter.Trim().Length > 0 || !_libraryClosed.Contains(group.Key);
                        var key = group.Key;
                        <div class="lib-cat" @onclick="() => ToggleCategory(key)">@(open ? "▾" : "▸") @key.Replace("/", " › ") <span>@group.Count()</span></div>
                        @if (open)
                        {
                            @foreach (var schema in group)
                            {
                                var item = schema;
                                <div class="lib-node" draggable="true" data-node="@item.Id" title="@item.Id" @onclick="() => PlaceFromLibrary(item)">@item.DisplayName</div>
                            }
                        }
                    }
                </div>
            </div>
        }

        @if (_historyOpen)
        {
            <div class="history">
                <div class="hist-head">
                    <span>@(_running ? "Running" : "Idle")@(_pending.Count > 0 ? $", {_pending.Count} queued" : "")</span>
                    <button title="Forget the runs listed here (the pictures stay where they were saved)" disabled="@(_history.Count == 0)" @onclick="ClearHistory">Clear</button>
                </div>
                <div class="hist-list">
                    @foreach (var waiting in _pending)
                    {
                        var queued = waiting;
                        <div class="hist-entry queued">
                            <div class="hist-title">Queued · @queued.At.ToString("HH:mm:ss")</div>
                            <div class="hist-engine">@queued.Engine</div>
                            <div class="hist-actions">
                                <button title="Take this run out of the queue" @onclick="() => CancelQueuedAsync(queued)">Cancel</button>
                            </div>
                        </div>
                    }
                    @foreach (var entry in _history)
                    {
                        var run = entry;
                        <div class="hist-entry @run.State">
                            <div class="hist-title">#@run.Number · @run.Started.ToString("HH:mm:ss")@(run.Seconds is { } sec ? $" · {sec:0.#} s" : "") · @run.State</div>
                            <div class="hist-engine">@run.Engine</div>
                            @if (run.Error is not null)
                            {
                                <div class="hist-error">@run.Error</div>
                            }
                            @if (run.Note is not null)
                            {
                                <div class="hist-note">@run.Note</div>
                            }
                            @foreach (var sound in run.Audio)
                            {
                                <audio controls src="@sound"></audio>
                            }
                            <div class="hist-thumbs">
                                @foreach (var url in run.Urls)
                                {
                                    var picture = url;
                                    <img src="@picture" alt="result" @onclick="() => _lightbox = picture" />
                                }
                            </div>
                            <div class="hist-actions">
                                <button title="Open this run's workflow in a new tab" @onclick="() => LoadRunWorkflow(run)">Load workflow</button>
                            </div>
                        </div>
                    }
                    @if (_history.Count == 0)
                    {
                        <div class="hist-none">Nothing has run yet. Press Queue.</div>
                    }
                </div>
            </div>
        }

        @if (_settingsOpen)
        {
            <div class="settings">
                <div class="set-head"><span>Settings</span><button title="Close" @onclick="() => _settingsOpen = false">&times;</button></div>
                <label>Link style
                    <select @onchange="OnLinkStyleChosen">
                        @foreach (var style in Enum.GetValues<LinkStyle>())
                        {
                            <option value="@((int)style)" selected="@(style == _settings.LinkStyle)">@style</option>
                        }
                    </select>
                </label>
                <label class="row"><input type="checkbox" checked="@_settings.SnapToGrid" @onchange="e => { _settings.SnapToGrid = (bool)(e.Value ?? false); ApplySettings(); }" /> Snap nodes to the grid</label>
                <label>Grid size
                    <input type="number" min="2" max="200" step="1" value="@_settings.GridSize" @onchange="OnGridSizeChosen" />
                </label>
                <label class="row"><input type="checkbox" checked="@_settings.ShowMinimap" @onchange="e => { _settings.ShowMinimap = (bool)(e.Value ?? false); ApplySettings(); }" /> Show the minimap</label>
            </div>
        }

        @if (_lightbox is not null)
        {
            <div class="lightbox" @onclick="() => _lightbox = null">
                <img src="@_lightbox" alt="result" />
                <button @onclick="DownloadLightbox" @onclick:stopPropagation="true">Download</button>
            </div>
        }

        @if (_message is not null)
        {
            <div class="toast">@_message</div>
        }

        @if (_edit is { } e)
        {
            <div class="widget-edit" style="left:@(Px(e.Bounds.X)); top:@(Px(e.Bounds.Y)); width:@(Px(Math.Max(e.Bounds.Width, 140))); height:@(Px(e.Bounds.Height))">
                @if (e.Spec?.Kind == WidgetKind.Combo)
                {
                    <select @ref="_editRef" @onchange="args => CommitEdit(args.Value?.ToString())" @onkeydown="EditKey">
                        @foreach (var option in e.Spec.ResolveOptions())
                        {
                            <option value="@option" selected="@(option == e.Text)">@option</option>
                        }
                    </select>
                }
                else if (e.Spec?.Multiline == true)
                {
                    <textarea @ref="_editRef" @bind="e.Text" @bind:event="oninput" @onblur="() => CommitEdit(e.Text)" @onkeydown="EditKey"></textarea>
                }
                else
                {
                    <input @ref="_editRef" type="@(e.Spec?.Kind is WidgetKind.Int or WidgetKind.Float ? "number" : "text")"
                           step="@(e.Spec?.Kind == WidgetKind.Float ? "any" : "1")" @bind="e.Text" @bind:event="oninput"
                           @onblur="() => CommitEdit(e.Text)" @onkeydown="EditKey" />
                }
            </div>
        }

        @if (_search is { } s)
        {
            <div class="search-backdrop" @onclick="CloseSearch">
                <div class="search" @onclick:stopPropagation>
                    <input @ref="_searchRef" placeholder="Search nodes..." value="@s.Query" @oninput="OnSearchInput" @onkeydown="SearchKey" />
                    <ul>
                        @{ var results = SearchResults().ToList(); }
                        @for (int i = 0; i < results.Count; i++)
                        {
                            var schema = results[i];
                            var index = i;
                            <li class="@(index == s.Selected ? "on" : "")" @onclick="() => PlaceFromSearch(schema)" @onmouseover="() => s.Selected = index">
                                <span class="name">@schema.DisplayName</span>
                                <span class="cat">@schema.Category</span>
                            </li>
                        }
                        @if (results.Count == 0)
                        {
                            <li class="none">No node matches "@s.Query".</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (_menu is { } m)
        {
            <ul class="menu" style="left:@(Px(m.At.X)); top:@(Px(m.At.Y))" @onpointerdown:stopPropagation>
                @foreach (var item in m.Items)
                {
                    <li @onclick="() => { CloseMenus(); item.Action(); }">@item.Label</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    sealed class EditState
    {
        public required int NodeId { get; init; }
        public string? Name { get; init; }           // null = editing the node title (or the group title when IsGroup)
        public bool IsGroup { get; init; }           // NodeId is a group id
        public WidgetSpec? Spec { get; init; }
        public required Rect Bounds { get; init; }
        public required string Text { get; set; }
    }

    sealed class SearchState
    {
        public string Query { get; set; } = "";
        public int Selected { get; set; }
        public Point At { get; init; }
        public LinkDraft? Draft { get; init; }
    }

    sealed record MenuItem(string Label, Action Action);
    sealed record MenuState(Point At, List<MenuItem> Items);

    ElementReference _canvasRef, _editRef, _searchRef;
    EditorDocument _doc = null!;
    EditorView _view = null!;
    NodeRenderer _renderer = null!;
    StudioCanvas? _studio;
    EditState? _edit;
    SearchState? _search;
    MenuState? _menu;
    string? _message;
    WorkflowTabs _tabs = new();
    string? _renamingTab;
    CancellationTokenSource? _autosave;
    bool _restoring;
    bool _focusEdit, _focusSearch, _uiPending;
    CancellationTokenSource? _toastTimer;

    static string Px(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    protected override void OnInitialized()
    {
        _doc = new EditorDocument(Registry);
        _view = new EditorView(_doc, text => _renderer!.MeasureText(text));
        _renderer = new NodeRenderer(_view, _visuals, _images);
        Server.EventReceived += OnServerEvent;
        Browser.EventReceived += OnServerEvent;
        Server.ConnectionChanged += RefreshUi;

        // Blazor only re-renders the toolbar and overlays; the canvas repaints itself. Throttled so a drag does not re-render on every move.
        _doc.Changed += RefreshUi;
        _view.ViewChanged += RefreshUi;
        _view.WidgetActivated += OnWidgetActivated;
        _view.GroupTitleEditRequested += OnGroupTitleEdit;
        _view.TitleEditRequested += OnTitleEdit;
        _view.SearchRequested += OpenSearch;
        _view.ContextMenuRequested += OnContextMenu;
        _view.Message += ShowMessage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _studio = new StudioCanvas(JS, _canvasRef.As<HTMLCanvasElement>(), _view, _renderer);
            _studio.FirstLayout += () => _view.FitToView();
            _studio.Shortcut += OnShortcut;
            await StartServerAsync(); // before the tabs open: a workflow may use the server's custom nodes
            _dropRef = DotNetObjectReference.Create(this);
            await Interop.InvokeVoidAsync("spawngenEnableDrop", _dropRef, ".stage");
            _studio.CanvasPressed += CloseMenus; // the canvas reports its own presses first, so a menu it opens right after is not closed again
            _settings = StudioSettings.FromJson(await Interop.InvokeAsync<string?>("spawngenStoreGet", SettingsKey));
            LinkGeometry.Style = _settings.LinkStyle;
            _view.SnapToGrid = _settings.SnapToGrid;
            _view.GridSize = _settings.GridSize;
            _view.MinimapVisible = _settings.ShowMinimap;
            await RestoreTabsAsync();
            _doc.Changed += ScheduleAutosave;
            _view.ViewChanged += OnViewMovedForAutosave;
            _studio.Focus();
        }
        // The click that opened an overlay is still finishing in the browser, and its default action moves focus to the canvas: focus the
        // overlay's input once that has happened, or typing would go to the canvas.
        if (_focusEdit)
        {
            _focusEdit = false;
            await Task.Delay(40);
            try { await _editRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { } // the editor was closed (a quick pick) before it could take focus
        }
        if (_focusSearch) { _focusSearch = false; await Task.Delay(40); await _searchRef.FocusAsync(); }
    }

    void RefreshUi()
    {
        if (_uiPending) return;
        _uiPending = true;
        _ = Task.Delay(120).ContinueWith(_ => { _uiPending = false; return InvokeAsync(StateHasChanged); });
    }

    Point CenterWorld() => _view.Viewport.ScreenToWorld(new Point(_view.ScreenSize.X / 2, _view.ScreenSize.Y / 2));

    // ---- workflow ----

    void LoadExample()
    {
        _doc.Clear();
        var ids = new Dictionary<string, int>();
        _doc.Group(() =>
        {
            int Add(string key, string type, double x, double y) => ids[key] = _doc.AddNode(type, x, y).Id;
            Add("ckpt", "CheckpointLoaderSimple", 30, 250);
            Add("pos", "CLIPTextEncode", 420, 40);
            Add("neg", "CLIPTextEncode", 420, 300);
            Add("latent", "EmptyLatentImage", 420, 560);
            Add("sampler", "KSampler", 860, 120);
            Add("decode", "VAEDecode", 1230, 120);
            Add("save", "SaveImage", 1230, 240);
            _doc.SetWidget(ids["ckpt"], "ckpt_name", "sd_turbo");
            _doc.SetWidget(ids["pos"], "text", "a photo of a red apple on a wooden table");
            _doc.SetWidget(ids["sampler"], "steps", 1L);
            _doc.SetWidget(ids["sampler"], "cfg", 1.0);
            void C(string from, int o, string to, string input) => _doc.Connect(ids[from], o, ids[to], input, out _);
            C("ckpt", 1, "pos", "clip"); C("ckpt", 1, "neg", "clip");
            C("ckpt", 0, "sampler", "model"); C("pos", 0, "sampler", "positive"); C("neg", 0, "sampler", "negative");
            C("latent", 0, "sampler", "latent_image"); C("sampler", 0, "decode", "samples"); C("ckpt", 2, "decode", "vae");
            C("decode", 0, "save", "images");
        });
        _doc.ClearHistory();
        _view.ClearSelection();
        _view.FitToView();
        _studio?.Focus();
    }

    async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await OpenBytesAsync(e.File.Name, memory.ToArray());
        }
        catch (IOException ex) { ShowMessage($"Could not read {e.File.Name}: {ex.Message}"); }
    }

    /// <summary>A file dropped on the canvas (see <c>spawngenEnableDrop</c> in index.html).</summary>
    [JSInvokable]
    public Task OnFileDropped(string name, byte[] bytes) => OpenBytesAsync(name, bytes);

    /// <summary>
    /// Opens a workflow JSON, an API-format prompt, or a picture generated by ComfyUI or SpawnGen (its PNG carries the workflow, or at least the prompt).
    /// A picture with neither is just a picture: it is offered to Load Image nodes.
    /// </summary>
    async Task OpenBytesAsync(string name, byte[] bytes)
    {
        try
        {
            bool isPng = bytes.Length > 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47;
            string? json = null;
            string source = name;
            if (isPng)
            {
                var text = PngReader.ReadText(bytes);
                if (text.TryGetValue("workflow", out var workflow)) { json = workflow; source = $"the workflow in {name}"; }
                else if (text.TryGetValue("prompt", out var prompt)) { json = prompt; source = $"the prompt in {name} (no editor layout was saved, so it is laid out automatically)"; }
                else
                {
                    if (_engine is null) { ShowMessage($"{name} has no workflow in it, and there is no engine to load it into."); return; }
                    var stored = await _engine.UploadImageAsync(name, bytes);
                    await RefreshInputImagesAsync();
                    ShowMessage(stored is null ? $"{name} has no workflow in it." : $"{name} has no workflow in it, so it was added as an input picture ({stored}).");
                    return;
                }
            }
            else json = System.Text.Encoding.UTF8.GetString(bytes);

            // A file opens in its own tab; if it turns out not to be a workflow the tab you were in is put back untouched.
            var before = Snapshot();
            IReadOnlyList<string> warnings;
            try
            {
                _restoring = true;
                warnings = ApiPromptImport.Looks(json) ? ApiPromptImport.Load(json, _doc) : ComfyWorkflow.Load(json, _doc);
            }
            catch
            {
                if (before is not null) ComfyWorkflow.Load(before, _doc);
                throw;
            }
            finally { _restoring = false; }
            var tabName = System.IO.Path.GetFileNameWithoutExtension(name);
            _tabs.Add(tabName);
            _view.ClearSelection();
            _view.FitToView();
            PersistTabs();
            ShowMessage(warnings.Count == 0 ? $"Opened {source}." : $"Opened {source} with {warnings.Count} warning(s): {warnings[0]}");
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
        {
            ShowMessage($"Could not open {name}: {ex.Message}");
        }
    }

    // ---- tabs and autosave ----

    const string TabsKey = "spawngen.tabs";

    /// <summary>The graph as workflow JSON, or null when saving it fails.</summary>
    string? Snapshot()
    {
        try { return ComfyWorkflow.Save(_doc, _renderer.MeasureText); }
        catch (Exception) { return null; }
    }

    /// <summary>Writes the graph and the view into the active tab.</summary>
    void CaptureActiveTab()
    {
        if (_tabs.Active is not { } tab) return;
        tab.Json = Snapshot() ?? tab.Json;
        tab.Scale = _view.Viewport.Scale;
        tab.OffsetX = _view.Viewport.OffsetX;
        tab.OffsetY = _view.Viewport.OffsetY;
    }

    void PersistTabs()
    {
        CaptureActiveTab();
        _ = Interop.InvokeVoidAsync("spawngenStoreSet", TabsKey, _tabs.ToJson());
    }

    /// <summary>Pan and zoom are remembered too, but hovering or selecting is not worth a write.</summary>
    void OnViewMovedForAutosave()
    {
        var vp = _view.Viewport;
        if (_tabs.Active is { } tab && (tab.Scale != vp.Scale || tab.OffsetX != vp.OffsetX || tab.OffsetY != vp.OffsetY)) ScheduleAutosave();
    }

    /// <summary>Saves a second after the last change, so typing or dragging is not written on every event.</summary>
    void ScheduleAutosave()
    {
        if (_restoring) return;
        _autosave?.Cancel();
        var source = _autosave = new CancellationTokenSource();
        _ = Task.Delay(1000, source.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled) InvokeAsync(PersistTabs);
        }, TaskScheduler.Default);
    }

    async Task RestoreTabsAsync()
    {
        var stored = WorkflowTabs.FromJson(await Interop.InvokeAsync<string?>("spawngenStoreGet", TabsKey));
        if (stored is null)
        {
            _tabs = new WorkflowTabs();
            _tabs.Add("Workflow");
            LoadExample();
            PersistTabs();
            return;
        }
        _tabs = stored;
        ActivateCurrent();
    }

    /// <summary>Shows the active tab: its saved graph and view, or the starter graph for a tab that has none (or whose file no longer loads).</summary>
    void ActivateCurrent()
    {
        var tab = _tabs.Active!;
        _restoring = true;
        try
        {
            if (tab.Json is not null)
            {
                try
                {
                    ComfyWorkflow.Load(tab.Json, _doc);
                    _view.ClearSelection();
                    _view.Viewport.Set(tab.Scale, tab.OffsetX, tab.OffsetY);
                    _view.Invalidate();
                    return;
                }
                catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
                {
                    ShowMessage($"Workflow '{tab.Name}' could not be restored ({ex.Message}); starting from the example.");
                }
            }
            LoadExample();
        }
        finally { _restoring = false; }
    }

    void SwitchTab(string id)
    {
        if (id == _tabs.ActiveId || _renamingTab is not null) return;
        CaptureActiveTab();
        _tabs.Activate(id);
        ActivateCurrent();
        PersistTabs();
        _studio?.Focus();
    }

    void NewTab()
    {
        CaptureActiveTab();
        _tabs.Add("Workflow");
        _restoring = true;
        try { LoadExample(); } finally { _restoring = false; }
        PersistTabs();
        _studio?.Focus();
    }

    void CloseTab(string id)
    {
        bool wasActive = id == _tabs.ActiveId;
        if (!_tabs.Close(id))
        {
            // The only tab: closing it starts over with the example.
            _restoring = true;
            try { LoadExample(); } finally { _restoring = false; }
            PersistTabs();
            return;
        }
        if (wasActive) ActivateCurrent(); else CaptureActiveTab();
        PersistTabs();
        _studio?.Focus();
    }

    void RenameKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "Escape") _renamingTab = null;
    }

    void RenameTab(string id, string? name)
    {
        _tabs.Rename(id, name ?? "");
        _renamingTab = null;
        PersistTabs();
        _studio?.Focus();
    }

    async Task SaveAsync()
    {
        var json = ComfyWorkflow.Save(_doc, _renderer.MeasureText);
