    void CommitEdit(string? text)
    {
        if (_edit is not { } e) return;
        _edit = null;
        text ??= "";
        // The node (or group) can be gone by the time the editor closes: packed into a subgraph, deleted, another workflow opened.
        if (e.IsGroup ? _doc.Graph.Groups.All(g => g.Id != e.NodeId) : _doc.Graph.FindNode(e.NodeId) is null) return;
        if (e.Crop is { } cropField && e.Name is { } cropName)
        {
            _view.SetCropField(e.NodeId, cropName, cropField, text);
            _studio?.Focus();
            return;
        }
        if (e.Box is { } boxField && e.Name is { } boxesName)
        {
            _view.SetBoxField(e.NodeId, boxesName, boxField.Index, boxField.Field, text);
            _studio?.Focus();
            return;
        }
        if (e.IsGroup)
        {
            _doc.SetGroupTitle(e.NodeId, string.IsNullOrWhiteSpace(text) ? "Group" : text.Trim());
        }
        else if (e.Name is null)
        {
            _doc.SetTitle(e.NodeId, string.IsNullOrWhiteSpace(text) ? null : text.Trim());
        }
        else if (e.Spec is { } spec)
        {
            object? value = spec.Kind switch
            {
                WidgetKind.Int => long.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var l) ? Clamp(spec, l) : null,
                WidgetKind.Float => double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? Clamp(spec, d) : null,
                WidgetKind.Json => SpawnGen.Engine.Types.JsonLiteral.TryParse(text, out var json) ? json : null,
                _ => text,
            };
            if (value is null) ShowMessage(spec.Kind == WidgetKind.Json ? $"'{text}' is not valid JSON." : $"'{text}' is not a valid number.");
            else _doc.SetWidget(e.NodeId, e.Name, value);
        }
        _doc.EndGesture();
        _studio?.Focus();
    }

    static object Clamp(WidgetSpec spec, double v)
    {
        if (spec.Min is { } min) v = Math.Max(v, min);
        if (spec.Max is { } max) v = Math.Min(v, max);
        return spec.Kind == WidgetKind.Int ? (object)(long)v : v;
    }

    void EditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _edit?.Spec?.Multiline != true) CommitEdit(_edit?.Text);
        else if (e.Key == "Escape") { _edit = null; _studio?.Focus(); }
    }

    // ---- node search ----

    void OpenSearch(Point world, LinkDraft? draft)
    {
        _search = new SearchState { At = world, Draft = draft };
        _focusSearch = true;
        InvokeAsync(StateHasChanged);
    }

    IEnumerable<NodeSchema> SearchResults()
    {
        var q = _search?.Query.Trim() ?? "";
        var all = Registry.Schemas.Where(s => !s.DevOnly).OrderBy(s => s.Category).ThenBy(s => s.DisplayName);
        if (q.Length == 0) return all.Take(14);
        var words = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        // Best matches first: the name is the query, starts with it, has a word starting with it, or just contains it.
        int Rank(NodeSchema s) =>
            s.DisplayName.Equals(q, StringComparison.OrdinalIgnoreCase) ? 0
            : s.DisplayName.StartsWith(q, StringComparison.OrdinalIgnoreCase) ? 1
            : s.DisplayName.Split(' ', '(', ')', '_').Any(part => part.StartsWith(q, StringComparison.OrdinalIgnoreCase)) ? 2 : 3;
        return all.Where(s => words.All(w => s.DisplayName.Contains(w, StringComparison.OrdinalIgnoreCase)
                                          || s.Id.Contains(w, StringComparison.OrdinalIgnoreCase)
                                          || s.Category.Contains(w, StringComparison.OrdinalIgnoreCase))).OrderBy(Rank).Take(14);
    }

    void OnSearchInput(ChangeEventArgs e)
    {
        if (_search is not { } s) return;
        s.Query = e.Value?.ToString() ?? "";
        s.Selected = 0;
    }

    void SearchKey(KeyboardEventArgs e)
    {
        if (_search is not { } s) return;
        var results = SearchResults().ToList();
        switch (e.Key)
        {
            case "ArrowDown": s.Selected = Math.Min(s.Selected + 1, Math.Max(results.Count - 1, 0)); break;
            case "ArrowUp": s.Selected = Math.Max(s.Selected - 1, 0); break;
            case "Enter" when results.Count > 0: PlaceFromSearch(results[Math.Min(s.Selected, results.Count - 1)]); break;
            case "Escape": CloseSearch(); break;
        }
    }

    void PlaceFromSearch(NodeSchema schema)
    {
        if (_search is not { } s) return;
        _search = null;
        _view.PlaceNode(schema.Id, s.At, s.Draft);
        _studio?.Focus();
    }

    void CloseSearch()
    {
        _search = null;
        _studio?.Focus();
    }

    // ---- context menu ----

    void OnContextMenu(Hit hit, Point screen)
    {
        var world = _view.Viewport.ScreenToWorld(screen);
        var items = new List<MenuItem>();
        if (hit.Kind is HitKind.NodeBody or HitKind.TitleBar or HitKind.Widget or HitKind.CollapseButton)
        {
            var node = _doc.Graph.GetNode(hit.NodeId);
            var chosen = _view.SelectedNodes.Contains(hit.NodeId) ? _view.SelectedNodes.ToList() : [hit.NodeId];
            var chosenOutputs = chosen.Where(id => _doc.Graph.FindNode(id) is { } n && Registry.GetSchema(n.ClassType)?.IsOutputNode == true).ToList();
            if (chosenOutputs.Count > 0 && _subgraphStack.Count == 0)
                items.Add(new(chosenOutputs.Count == 1 ? "Queue Selected Output Node" : $"Queue Selected Output Nodes ({chosenOutputs.Count})", () => _ = QueueAsync(targets: chosenOutputs)));
            items.Add(new("Rename", () => OnTitleEdit(hit.NodeId)));
            items.Add(new("Properties Panel  (I)", () => { _propsOpen = true; InvokeAsync(StateHasChanged); }));
            items.Add(new(chosen.Count > 1 ? $"Clone ({chosen.Count})" : "Clone", () => _view.Duplicate(chosen)));
            if (SubgraphLibrary.Get(node.ClassType) is not null)
            {
                items.Add(new("Open Subgraph", () => EnterSubgraph(node)));
                items.Add(new("Unpack Subgraph  (Ctrl+Shift+E)", () => _view.ToggleSubgraph()));
            }
            else items.Add(new(_view.SelectedNodes.Count > 1 ? "Convert Selection to Subgraph  (Ctrl+Shift+E)" : "Convert to Subgraph  (Ctrl+Shift+E)", () => _view.ToggleSubgraph()));
            if (node.ClassType is "LoadImage" or "LoadImageMask")
                items.Add(new("Open in Mask Editor", () => _ = OpenMaskEditorAsync(node)));
            if (node.ClassType == "LoadImageOutput")
                items.Add(new("Refresh and pick the newest output", () => _ = PickNewestOutputAsync(hit.NodeId)));
            // ComfyUI's Mode: Always, On Event, Never, On Trigger (the two LiteGraph event modes run like Always).
            items.Add(SubMenu("Mode", [.. new (string Name, NodeMode Mode)[] { ("Always", NodeMode.Always), ("On Event", NodeMode.OnEvent), ("Never", NodeMode.Never), ("On Trigger", NodeMode.OnTrigger) }
                .Select(m => new MenuItem(m.Name, () => { foreach (var id in chosen) _doc.SetMode(id, m.Mode); _doc.EndGesture(); }))]));
            // Resize: back to the size the node's content needs (a width dragged by hand is dropped).
            items.Add(new("Resize", () => { foreach (var id in chosen) _doc.SetWidth(id, null); _doc.EndGesture(); }));
            var colours = new List<MenuItem>
            {
                new("No color", () => { foreach (var id in chosen) _doc.SetNodeColor(id, null, null); _doc.EndGesture(); }),
            };
            foreach (var (name, color, bg) in EditorGroup.NodePalette)
                colours.Add(new(name, () => { foreach (var id in chosen) _doc.SetNodeColor(id, color, bg); _doc.EndGesture(); }));
            items.Add(SubMenu("Colours", colours));
            // ComfyUI's Shapes: the outline of the node (saved as its shape).
            items.Add(SubMenu("Shapes", [.. new (string Name, NodeShape? Shape)[] { ("default", null), ("box", NodeShape.Box), ("round", NodeShape.Round), ("card", NodeShape.Card) }
                .Select(s => new MenuItem(s.Name, () => { foreach (var id in chosen) _doc.SetShape(id, s.Shape); _doc.EndGesture(); }))]));
            if (node.Previews.Count > 0)
            {
                items.Add(new("Open Image", () => { _lightbox = node.Previews[0].Url; InvokeAsync(StateHasChanged); }));
                items.Add(new("Save picture", () => _ = SavePicturesAsync(node)));
            }
            if (node.ResultModels.Count > 0)
                items.Add(new("View 3D model", () => View3D(node.ResultModels[0])));
            if (!node.Pinned) items.Add(new(node.Collapsed ? "Expand" : "Collapse", () => { _doc.SetCollapsed(hit.NodeId, !node.Collapsed); _doc.EndGesture(); }));
            items.Add(new(node.Pinned ? "Unpin  (P)" : "Pin  (P)", () => _view.TogglePin()));
            items.Add(new(node.Mode == NodeMode.Never ? "Unmute" : "Mute  (Ctrl+M)", () => _view.Key("m", Modifiers.Ctrl)));
            items.Add(new(node.Mode == NodeMode.Bypass ? "Remove bypass" : "Bypass  (Ctrl+B)", () => _view.Key("b", Modifiers.Ctrl)));
            items.Add(new("Copy  (Ctrl+C)", () => _view.Copy()));
            items.Add(new("Delete  (Del)", () => _view.DeleteSelection()));
        }
        else if (hit.Kind == HitKind.Link)
        {
            items.Add(new("Add Reroute here", () => { _doc.InsertReroute(hit.LinkId, world.X, world.Y); _doc.EndGesture(); }));
            items.Add(new("Delete link", () => _doc.Disconnect(hit.LinkId)));
        }
        else if (hit.Kind == HitKind.InputSlot)
        {
            // An input dot: what feeds it can be taken out; an empty one offers the search for a node to feed it.
            if (hit.Name is { } input && _doc.Graph.LinkInto(hit.NodeId, input) is { } link)
                items.Add(new("Disconnect", () => { _doc.Disconnect(link.Id); _doc.EndGesture(); }));
            else
                items.Add(new("Add node...", () => OpenSearch(world, null)));
        }
        else if (hit.Kind == HitKind.OutputSlot)
        {
            int count = _doc.Graph.LinksFrom(hit.NodeId, hit.Index).Count();
            if (count > 0)
                items.Add(new(count == 1 ? "Disconnect" : $"Disconnect links ({count})", () => { _doc.DisconnectOutput(hit.NodeId, hit.Index); _doc.EndGesture(); }));
            else
                items.Add(new("Add node...", () => OpenSearch(world, null)));
        }
        else if (hit.Kind == HitKind.GroupTitle)
        {
            items.Add(new("Edit group title", () => OnGroupTitleEdit(hit.NodeId)));
            items.Add(SubMenu("Colours", [.. EditorGroup.Palette.Select(p => new MenuItem(p.Name, () => { _doc.SetGroupColor(hit.NodeId, p.Color); _doc.EndGesture(); }))]));
            var pinnedGroup = _doc.Graph.GetGroup(hit.NodeId).Pinned;
            items.Add(new(pinnedGroup ? "Unpin group  (P)" : "Pin group  (P)", () => { _doc.SetGroupPinned(hit.NodeId, !pinnedGroup); _doc.EndGesture(); }));
            if (!pinnedGroup) items.Add(new("Delete group  (Del)", () => { _doc.DeleteGroup(hit.NodeId); }));
        }
        else
        {
            items.Add(new("Add node...", () => OpenSearch(world, null)));
            items.Add(new("Add group here", () => { _doc.AddGroup(world.X, world.Y, 420, 300); _doc.EndGesture(); }));
            if (_view.SelectedNodes.Count > 0) items.Add(new("Group selected nodes  (Ctrl+G)", () => _view.GroupSelection()));
            if (_view.SelectedNodes.Count > 1)
                items.Add(SubMenu("Align", [.. Enum.GetValues<AlignEdge>().Select(edge => new MenuItem(edge.ToString(), () => _view.AlignSelection(edge)))]));
            if (_view.CanPaste) items.Add(new("Paste  (Ctrl+V)", () => _view.Paste(world)));
            AddTemplateMenu(items, world);
            items.Add(new("Fit view  (F)", () => _view.FitToView()));
        }
        _openSub = null;
        _menu = new MenuState(screen, items);
        InvokeAsync(StateHasChanged);
    }

