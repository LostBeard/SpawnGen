    void ClearHistory() => _history.RemoveAll(e => e.State != "running");

    /// <summary>
    /// Prompts that already started: a fast engine can report a run's start before the queue call that sent it returns, and that run must not then
    /// be listed as waiting.
    /// </summary>
    readonly HashSet<string> _startedIds = [];

    void StartHistoryEntry(string? promptId)
    {
        if (promptId is not null)
        {
            if (_startedIds.Count > 256) _startedIds.Clear(); // runs other clients queued are never matched here
            _startedIds.Add(promptId);
        }
        var started = _pending.FirstOrDefault(p => p.Id == promptId) ?? (_pending.Count > 0 && promptId is null ? _pending[0] : null);
        if (started is not null) _pending.Remove(started);
        var workflow = started?.Workflow ?? Snapshot() ?? "";
        _history.Insert(0, new HistoryEntry { PromptId = promptId, Number = ++_runNumber, Started = DateTime.Now, Engine = _engine?.Name ?? "", Workflow = workflow });
        if (_history.Count > 50) _history.RemoveAt(_history.Count - 1);
    }

    /// <summary>
    /// The engine's earlier runs (ComfyUI's queue panel lists the server's history after a reload): each run this page does not list yet, with its
    /// pictures, sound and workflow (extra_data.extra_pnginfo.workflow), newest first, after this page's own runs.
    /// </summary>
    async Task LoadPastRunsAsync(IEngineClient engine)
    {
        if (await engine.GetHistoryAsync(50) is not { } history) return;
        var known = _history.Select(h => h.PromptId).Where(id => id is not null).ToHashSet();
        var past = new List<HistoryEntry>();
        foreach (var (id, node) in history)
        {
            if (known.Contains(id) || node is not JsonObject run) continue;
            if (PastRun(engine, id, run) is { } entry) past.Add(entry);
        }
        _history.AddRange(past.OrderByDescending(p => p.Started));
        if (_history.Count > 50) _history.RemoveRange(50, _history.Count - 50);
        _runNumber = Math.Max(_runNumber, _history.Count == 0 ? 0 : _history.Max(h => h.Number));
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>One /history entry as a history panel entry (null when it is not one).</summary>
    static HistoryEntry? PastRun(IEngineClient engine, string id, JsonObject run)
    {
        if (run["prompt"] is not JsonArray prompt || prompt.Count < 4) return null;
        var extra = prompt[3] as JsonObject;
        var messages = (run["status"]?["messages"] as JsonArray)?.OfType<JsonArray>().Where(m => m.Count == 2).ToList() ?? [];
        long? Stamp(string name) => messages.FirstOrDefault(m => (string?)m[0] == name)?[1]?["timestamp"] is JsonValue t && t.TryGetValue<long>(out var v) ? v : null;
        long? created = extra?["create_time"] is JsonValue c && c.TryGetValue<long>(out var ct) ? ct : Stamp("execution_start");
        var last = messages.Count > 0 && messages[^1][1]?["timestamp"] is JsonValue lt && lt.TryGetValue<long>(out var lv) ? lv : (long?)null;
        var end = messages.Count > 0 ? (string?)messages[^1][0] : null;
        var state = (string?)run["status"]?["status_str"] == "success" ? "done" : end == "execution_interrupted" ? "stopped" : "failed";
        var entry = new HistoryEntry
        {
            PromptId = id, Past = true,
            Number = prompt[0] is JsonValue n && n.TryGetValue<int>(out var number) ? number : 0,
            Started = created is { } ms ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime : DateTime.MinValue,
            Engine = engine.Name,
            Workflow = extra?["extra_pnginfo"]?["workflow"]?.ToJsonString() ?? "",
            State = state,
            Seconds = created is { } s0 && last is { } s1 && s1 >= s0 ? (s1 - s0) / 1000.0 : null,
            Error = state == "failed" ? (string?)messages.LastOrDefault(m => (string?)m[0] == "execution_error")?[1]?["exception_message"] : null,
        };
        foreach (var (_, output) in run["outputs"] as JsonObject ?? [])
        {
            foreach (var file in (output?["images"] as JsonArray)?.OfType<JsonObject>() ?? [])
                if ((string?)file["filename"] is { } name && !name.EndsWith(".glb", StringComparison.OrdinalIgnoreCase))
                    entry.Urls.Add(engine.ViewUrl(name, (string?)file["subfolder"], (string?)file["type"]));
            foreach (var file in (output?["audio"] as JsonArray)?.OfType<JsonObject>() ?? [])
                if ((string?)file["filename"] is { } name) entry.Audio.Add(engine.ViewUrl(name, (string?)file["subfolder"], (string?)file["type"]));
        }
        return entry;
    }

    void FinishHistoryEntry(string state, string? error)
    {
        if (_history.FirstOrDefault(e => e.State == "running") is not { } entry) return;
        entry.State = state;
        entry.Error = error;
        if (state == "done" && entry.Urls.Count == 0 && entry.Audio.Count == 0 && entry.Models.Count == 0) entry.Note = "No new pictures: every output was cached from an earlier run (nothing changed).";
        entry.Seconds = (DateTime.Now - entry.Started).TotalSeconds;
    }

    async Task LoadRunWorkflow(HistoryEntry entry)
    {
        if (entry.Workflow.Length == 0) { ShowMessage("That run has no workflow saved."); return; }
        await OpenBytesAsync($"run-{entry.Number}.json", System.Text.Encoding.UTF8.GetBytes(entry.Workflow));
    }

