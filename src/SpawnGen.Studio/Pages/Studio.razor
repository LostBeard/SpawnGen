        public string? Error { get; set; }
        public string? Note { get; set; }
    }

    bool _historyOpen;
    string? _lightbox;
    int _runNumber;
    readonly List<HistoryEntry> _history = [];           // newest first
    sealed record PendingRun(string Id, string Workflow, DateTime At, string Engine);
    readonly List<PendingRun> _pending = [];             // runs waiting in the engine's queue, in the order they start

    async Task CancelQueuedAsync(PendingRun run)
    {
        _pending.Remove(run);
        if (_engine is not null) await _engine.CancelQueuedAsync(run.Id);
    }

    void ToggleHistory()
    {
        _historyOpen = !_historyOpen;
        _studio?.Focus();
    }

    void ClearHistory() => _history.RemoveAll(e => e.State != "running");

    void StartHistoryEntry(string? promptId)
    {
        var started = _pending.FirstOrDefault(p => p.Id == promptId) ?? (_pending.Count > 0 ? _pending[0] : null);
        if (started is not null) _pending.Remove(started);
        var workflow = started?.Workflow ?? Snapshot() ?? "";
        _history.Insert(0, new HistoryEntry { Number = ++_runNumber, Started = DateTime.Now, Engine = _engine?.Name ?? "", Workflow = workflow });
        if (_history.Count > 50) _history.RemoveAt(_history.Count - 1);
    }

    void FinishHistoryEntry(string state, string? error)
    {
        if (_history.FirstOrDefault(e => e.State == "running") is not { } entry) return;
        entry.State = state;
        entry.Error = error;
        if (state == "done" && entry.Urls.Count == 0 && entry.Audio.Count == 0) entry.Note = "No new pictures: every output was cached from an earlier run (nothing changed).";
        entry.Seconds = (DateTime.Now - entry.Started).TotalSeconds;
    }

    async Task LoadRunWorkflow(HistoryEntry entry)
    {
        if (entry.Workflow.Length == 0) { ShowMessage("That run has no workflow saved."); return; }
        await OpenBytesAsync($"run-{entry.Number}.json", System.Text.Encoding.UTF8.GetBytes(entry.Workflow));
    }

