    protected override void OnInitialized()
    {
        _doc = new EditorDocument(Registry);
        _view = new EditorView(_doc, text => _renderer!.MeasureText(text));
        _renderer = new NodeRenderer(_view, _visuals, _images);
        _renderer.CropPictureUrl = CropPictureUrl;
        _view.CropPictureSize = id => _doc.Graph.FindNode(id) is { } cropped && CropPictureUrl(cropped) is { } url && _renderer.PictureSizes.TryGetValue(url, out var size)
            ? size : null;
        Server.EventReceived += OnServerEvent;
        Browser.EventReceived += OnServerEvent;
        Server.ConnectionChanged += RefreshUi;

        // Blazor only re-renders the toolbar and overlays; the canvas repaints itself. Throttled so a drag does not re-render on every move.
        _doc.Changed += RefreshUi;
        _view.ViewChanged += RefreshUi;
        _view.WidgetActivated += OnWidgetActivated;
        _view.BoxFieldActivated += OnBoxFieldActivated;
        _view.CropFieldActivated += OnCropFieldActivated;
        _view.WidgetPicked += OnAppWidgetPicked;
        _view.NodePicked += OnAppNodePicked;
        _view.GroupTitleEditRequested += OnGroupTitleEdit;
        _view.TitleEditRequested += OnTitleEdit;
        _view.SearchRequested += OpenSearch;
        _view.ContextMenuRequested += OnContextMenu;
        _view.Message += ShowMessage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _studio = new StudioCanvas(JS, _canvasRef.As<HTMLCanvasElement>(), _view, _renderer);
            _studio.FirstLayout += () => _view.FitToView();
            _studio.Shortcut += OnShortcut;
            await StartServerAsync(); // before the tabs open: a workflow may use the server's custom nodes
            _dropRef = DotNetObjectReference.Create(this);
            await Interop.InvokeVoidAsync("spawngenEnableDrop", _dropRef, ".stage");
            _studio.CanvasPressed += CloseMenus; // the canvas reports its own presses first, so a menu it opens right after is not closed again
            _settings = await LoadSettingsAsync();
            _ = LoadNodeTemplatesAsync();
            LinkGeometry.Style = _settings.LinkStyle;
            _view.SnapToGrid = _settings.SnapToGrid;
            _view.GridSize = _settings.GridSize;
            _view.MinimapVisible = _settings.ShowMinimap;
            _view.ShowNodeIds = _settings.ShowNodeIds;
            _studio.Bindings = _bindings = KeyBindings.FromJson(_settings.Shortcuts);
            Theme.Use(_settings.Palette); // the page itself was already themed by index.html before the app booted
            await RestoreTabsAsync();
            _doc.Changed += ScheduleAutosave;
            _view.ViewChanged += OnViewMovedForAutosave;
            _studio.Focus();
        }
        // The click that opened an overlay is still finishing in the browser, and its default action moves focus to the canvas: focus the
        // overlay's input once that has happened, or typing would go to the canvas.
        if (_focusEdit)
        {
            _focusEdit = false;
            await Task.Delay(40);
            try { await _editRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { } // the editor was closed (a quick pick) before it could take focus
        }
        if (_focusSearch) { _focusSearch = false; await Task.Delay(40); await _searchRef.FocusAsync(); }
        if (_focusTemplateName)
        {
            _focusTemplateName = false;
            await Task.Delay(40);
            try { await _templateNameRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { }
        }
        if (_focusCapture)
        {
            _focusCapture = false;
            await Task.Delay(30);
            try { await _captureRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { }
        }
        if (_focusLibraryInput is { } which)
        {
            _focusLibraryInput = null;
            await Task.Delay(40);
            try { await (which ? _saveNameRef : _renameRef).FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { }
        }
    }

    void RefreshUi()
    {
        if (_uiPending) return;
        _uiPending = true;
        _ = Task.Delay(120).ContinueWith(_ => { _uiPending = false; return InvokeAsync(StateHasChanged); });
    }

    // ---- workflow ----

    // ---- ComfyUI's templates ----

    sealed record TemplateEntry(string Name, string? Title, string? Description, List<string>? Tags, List<string>? Models, bool? OpenSource, string? MediaSubtype);
    sealed record TemplateGroup(string? Title, string? Category, List<TemplateEntry>? Templates);

    /// <summary>Comfy-Org's templates (MIT) for the browser engine; the server serves the same files at /templates (its own cached copies).</summary>
    const string TemplatesUpstream = "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/";

    List<TemplateGroup>? _templateIndex;
    string? _templateError;
    bool _templatesOpen;
    string _templateFilter = "";
    int _templateGroup = -1, _templateLimit = 60;

    void OnTemplateFilter(ChangeEventArgs e) { _templateFilter = e.Value?.ToString() ?? ""; _templateLimit = 60; }

    string TemplateUrl(string file) => _engine is ServerClient ? "templates/" + file : TemplatesUpstream + file;

    async Task OpenTemplatesAsync()
    {
        _templatesOpen = !_templatesOpen;
        _templateLimit = 60;
        if (!_templatesOpen || _templateIndex is not null) return;
        StateHasChanged();
        try
        {
            _templateIndex = await Http.GetFromJsonAsync<List<TemplateGroup>>(TemplateUrl("index.json"),
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            _templateError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            _templateError = "The templates could not be read: " + ex.Message;
        }
    }

    /// <summary>The templates of the chosen group (or all, once each), whose name, title, description, tags or models hold every word typed.</summary>
    IEnumerable<TemplateEntry> TemplatesShown()
    {
        if (_templateIndex is null) yield break;
        var words = _templateFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var seen = new HashSet<string>(StringComparer.Ordinal);
        var groups = _templateGroup >= 0 && _templateGroup < _templateIndex.Count ? [_templateIndex[_templateGroup]] : _templateIndex;
        foreach (var g in groups)
            foreach (var t in g.Templates ?? [])
            {
                if (!seen.Add(t.Name)) continue;
                var text = string.Join(' ', [t.Name, t.Title, t.Description, .. t.Tags ?? [], .. t.Models ?? []]);
                if (words.All(w => text.Contains(w, StringComparison.OrdinalIgnoreCase))) yield return t;
            }
    }

    async Task OpenTemplateAsync(TemplateEntry t)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(TemplateUrl(t.Name + ".json"));
            _templatesOpen = false;
            await OpenBytesAsync((t.Title ?? t.Name) + ".json", bytes);
        }
        catch (HttpRequestException ex) { ShowMessage("Could not load the template: " + ex.Message); }
    }

    sealed record ExampleEntry(string Name, string File, string Note);
    List<ExampleEntry>? _examples;

    /// <summary>The list of example workflows (examples/index.json next to the page) as a menu; each opens in its own tab.</summary>
    async Task OpenExamples()
    {
        try { _examples ??= await Http.GetFromJsonAsync<List<ExampleEntry>>("examples/index.json"); }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { _examples = null; }
        var items = new List<MenuItem> { new("Starter graph in this tab", LoadExample) };
        foreach (var example in _examples ?? []) items.Add(new(example.Name, () => _ = OpenExampleAsync(example)));
        if (_examples is null) ShowMessage("The example list could not be read.");
        _openSub = null;
        _menu = new MenuState(new Point(8, 6), items);
    }

    async Task OpenExampleAsync(ExampleEntry example)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync("examples/" + example.File);
            await OpenBytesAsync(example.Name + ".json", bytes);
            ShowMessage(example.Note);
        }
        catch (HttpRequestException ex) { ShowMessage("Could not load the example: " + ex.Message); }
    }

    void LoadExample()
    {
        _doc.Clear();
        var ids = new Dictionary<string, int>();
        _doc.Group(() =>
        {
            int Add(string key, string type, double x, double y) => ids[key] = _doc.AddNode(type, x, y).Id;
            Add("ckpt", "CheckpointLoaderSimple", 30, 250);
            Add("pos", "CLIPTextEncode", 420, 40);
            Add("neg", "CLIPTextEncode", 420, 300);
            Add("latent", "EmptyLatentImage", 420, 560);
            Add("sampler", "KSampler", 860, 120);
            Add("decode", "VAEDecode", 1230, 120);
            Add("save", "SaveImage", 1230, 240);
            _doc.SetWidget(ids["ckpt"], "ckpt_name", "sd_turbo");
            _doc.SetWidget(ids["pos"], "text", "a photo of a red apple on a wooden table");
            _doc.SetWidget(ids["latent"], "width", 512L); // SD-Turbo's size (Empty Latent Image defaults to ComfyUI's 1024)
            _doc.SetWidget(ids["latent"], "height", 512L);
            _doc.SetWidget(ids["sampler"], "steps", 1L);
            _doc.SetWidget(ids["sampler"], "cfg", 1.0);
            void C(string from, int o, string to, string input) => _doc.Connect(ids[from], o, ids[to], input, out _);
            C("ckpt", 1, "pos", "clip"); C("ckpt", 1, "neg", "clip");
            C("ckpt", 0, "sampler", "model"); C("pos", 0, "sampler", "positive"); C("neg", 0, "sampler", "negative");
            C("latent", 0, "sampler", "latent_image"); C("sampler", 0, "decode", "samples"); C("ckpt", 2, "decode", "vae");
            C("decode", 0, "save", "images");
        });
        _doc.ClearHistory();
        _view.ClearSelection();
        _view.FitToView();
        _studio?.Focus();
    }

    /// <summary>
    /// Bumped after every file pick: the file inputs are made anew, so choosing the same file again (the same picture for another engine, the same
    /// workflow twice) still fires their change event, which a browser skips for an unchanged selection.
    /// </summary>
    int _fileInputs;

    async Task OnFileChosenAsync(InputFileChangeEventArgs e)
    {
        try { await OnFileChosen(e); }
        finally { _fileInputs++; StateHasChanged(); }
    }

    async Task OnUploadChosenAsync(InputFileChangeEventArgs e)
    {
        try { await OnUploadChosen(e); }
        finally { _fileInputs++; StateHasChanged(); }
    }

    async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await OpenBytesAsync(e.File.Name, memory.ToArray());
        }
        catch (IOException ex) { ShowMessage($"Could not read {e.File.Name}: {ex.Message}"); }
    }

    /// <summary>A file dropped on the canvas (see <c>spawngenEnableDrop</c> in index.html).</summary>
    [JSInvokable]
    public Task OnFileDropped(string name, byte[] bytes) => OpenBytesAsync(name, bytes);

    /// <summary>
    /// Opens a workflow JSON, an API-format prompt, or a picture generated by ComfyUI or SpawnGen (its PNG carries the workflow, or at least the prompt).
    /// A picture with neither is just a picture: it is offered to Load Image nodes.
    /// </summary>
    async Task OpenBytesAsync(string name, byte[] bytes)
    {
        try
        {
            bool isPng = bytes.Length > 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47;
            string? json = null;
            string source = name;
            if (isPng)
            {
                var text = PngReader.ReadText(bytes);
                if (text.TryGetValue("workflow", out var workflow)) { json = workflow; source = $"the workflow in {name}"; }
                else if (text.TryGetValue("prompt", out var prompt)) { json = prompt; source = $"the prompt in {name} (no editor layout was saved, so it is laid out automatically)"; }
                else
                {
                    if (_engine is null) { ShowMessage($"{name} has no workflow in it, and there is no engine to load it into."); return; }
                    var stored = await _engine.UploadImageAsync(name, bytes);
                    await RefreshInputImagesAsync();
                    ShowMessage(stored is null ? $"{name} has no workflow in it." : $"{name} has no workflow in it, so it was added as an input picture ({stored}).");
                    return;
                }
            }
            else json = System.Text.Encoding.UTF8.GetString(bytes);

            OpenWorkflowText(json, System.IO.Path.GetFileNameWithoutExtension(name), source, null);
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
        {
            ShowMessage($"Could not open {name}: {ex.Message}");
        }
    }

    /// <summary>
    /// Opens workflow (or API-format) JSON in a new tab named <paramref name="tabName"/> (a ComfyUI app's ".app" taken off), remembering the library
    /// file it came from. If it is not a workflow the tab you were in is put back untouched and the reason shown; returns whether it opened.
    /// </summary>
    bool OpenWorkflowText(string json, string tabName, string source, string? libraryPath)
    {
        CaptureActiveTab(); // the tab you were in keeps its latest edits
        var before = Snapshot();
        IReadOnlyList<string> warnings;
        try
        {
            _restoring = true;
            warnings = ApiPromptImport.Looks(json) ? ApiPromptImport.Load(json, _doc) : ComfyWorkflow.Load(json, _doc);
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
        {
            if (before is not null) ComfyWorkflow.Load(before, _doc);
            ShowMessage($"Could not open {source}: {ex.Message}");
            return false;
        }
        finally { _restoring = false; }
        if (tabName.EndsWith(".app", StringComparison.OrdinalIgnoreCase)) tabName = tabName[..^4]; // a ComfyUI app file, name.app.json
        _subgraphStack.Clear();
        _tabs.Add(tabName).Path = libraryPath;
        _view.ClearSelection();
        _view.FitToView();
        SyncAppFromDocument(opening: true);
        PersistTabs();
        ShowMessage(warnings.Count == 0 ? $"Opened {source}." : $"Opened {source} with {warnings.Count} warning(s): {warnings[0]}");
        return true;
    }

    // ---- tabs and autosave ----

    const string TabsKey = "spawngen.tabs";

    /// <summary>The graph as workflow JSON, or null when saving it fails.</summary>
    string? Snapshot()
    {
        try { return _subgraphStack.Count > 0 ? RootJson() : ComfyWorkflow.Save(_doc, _renderer.MeasureText); }
        catch (Exception) { return null; }
    }

    // ---- inside a subgraph ----

    /// <summary>An outer level while a subgraph is open: its graph as workflow JSON, its view, and the name shown in the breadcrumbs.</summary>
    sealed record SubgraphLevel(string Json, double Scale, double OffsetX, double OffsetY, string Name);

    /// <summary>The levels outside the open subgraph, the tab's own workflow first. Empty when the tab's workflow itself is on the canvas.</summary>
    readonly List<SubgraphLevel> _subgraphStack = [];

    /// <summary>Opens a subgraph instance to edit its inside (ComfyUI's "open subgraph"): the canvas shows its nodes between its input and output boundary.</summary>
    void EnterSubgraph(EditorNode instance)
    {
        if (SubgraphLibrary.Get(instance.ClassType) is not { } def) return;
        var vp = _view.Viewport;
        var name = SubgraphEditing.EditedId(_doc) is { } outer ? SubgraphLibrary.Get(outer)?.Name ?? "Subgraph" : _tabs.Active?.Name ?? "Workflow";
        _subgraphStack.Add(new SubgraphLevel(ComfyWorkflow.Save(_doc, _renderer.MeasureText), vp.Scale, vp.OffsetX, vp.OffsetY, name));
        _restoring = true;
        try { SubgraphEditing.Open(_doc, def); } finally { _restoring = false; }
        _view.ClearSelection();
        _view.FitToView();
        StateHasChanged();
        _studio?.Focus();
    }

    /// <summary>Goes back out to level <paramref name="level"/> (0 is the tab's workflow), writing each subgraph that was open back into its definition.</summary>
    void ExitSubgraphTo(int level)
    {
        _restoring = true;
        try
        {
            while (_subgraphStack.Count > level)
            {
                if (SubgraphEditing.EditedId(_doc) is { } id && SubgraphLibrary.Get(id) is { } def) SubgraphEditing.Commit(_doc, def);
                var outer = _subgraphStack[^1];
                _subgraphStack.RemoveAt(_subgraphStack.Count - 1);
                ComfyWorkflow.Load(outer.Json, _doc); // the newer revision of what was just edited is kept
                _view.ClearSelection();
                _view.Viewport.Set(outer.Scale, outer.OffsetX, outer.OffsetY);
            }
        }
        finally { _restoring = false; }
        _view.Invalidate();
        ScheduleAutosave();
        StateHasChanged();
        _studio?.Focus();
    }

    /// <summary>
    /// The tab's whole workflow while a subgraph is open: every open level is written into its definition (innermost first), then the tab's own
    /// workflow is saved again, so it carries the edited definitions. Nothing on the canvas changes.
    /// </summary>
    string RootJson()
    {
        if (SubgraphEditing.EditedId(_doc) is { } id && SubgraphLibrary.Get(id) is { } def) SubgraphEditing.Commit(_doc, def);
        for (int i = _subgraphStack.Count - 1; i >= 1; i--)
        {
            var level = new EditorDocument(Registry);
            ComfyWorkflow.Load(_subgraphStack[i].Json, level);
            if (SubgraphEditing.EditedId(level) is { } levelId && SubgraphLibrary.Get(levelId) is { } levelDef) SubgraphEditing.Commit(level, levelDef);
        }
        var root = new EditorDocument(Registry);
        ComfyWorkflow.Load(_subgraphStack[0].Json, root);
        return ComfyWorkflow.Save(root, _renderer.MeasureText);
    }

    /// <summary>Writes the graph and the view into the active tab.</summary>
    void CaptureActiveTab()
    {
        if (_tabs.Active is not { } tab) return;
        tab.Json = Snapshot() ?? tab.Json;
        tab.Scale = _view.Viewport.Scale;
        tab.OffsetX = _view.Viewport.OffsetX;
        tab.OffsetY = _view.Viewport.OffsetY;
    }

    void PersistTabs()
    {
        CaptureActiveTab();
        _ = Interop.InvokeVoidAsync("spawngenStoreSet", TabsKey, _tabs.ToJson());
    }

    /// <summary>Pan and zoom are remembered too, but hovering or selecting is not worth a write.</summary>
    void OnViewMovedForAutosave()
    {
        var vp = _view.Viewport;
        if (_tabs.Active is { } tab && (tab.Scale != vp.Scale || tab.OffsetX != vp.OffsetX || tab.OffsetY != vp.OffsetY)) ScheduleAutosave();
    }

    /// <summary>Saves a second after the last change, so typing or dragging is not written on every event.</summary>
    void ScheduleAutosave()
    {
        if (_restoring) return;
        _autosave?.Cancel();
        var source = _autosave = new CancellationTokenSource();
        _ = Task.Delay(1000, source.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled) InvokeAsync(PersistTabs);
        }, TaskScheduler.Default);
    }

    async Task RestoreTabsAsync()
    {
        var stored = WorkflowTabs.FromJson(await Interop.InvokeAsync<string?>("spawngenStoreGet", TabsKey));
        if (stored is null)
        {
            _tabs = new WorkflowTabs();
            _tabs.Add("Workflow");
            LoadExample();
            PersistTabs();
            return;
        }
        _tabs = stored;
        ActivateCurrent();
    }

    /// <summary>Shows the active tab: its saved graph and view, or the starter graph for a tab that has none (or whose file no longer loads).</summary>
    void ActivateCurrent()
    {
        var tab = _tabs.Active!;
        _restoring = true;
        try
        {
            if (tab.Json is not null)
            {
                try
                {
                    ComfyWorkflow.Load(tab.Json, _doc);
                    _view.ClearSelection();
                    _view.Viewport.Set(tab.Scale, tab.OffsetX, tab.OffsetY);
                    _view.Invalidate();
                    return;
                }
                catch (Exception ex) when (ex is InvalidDataException or System.Text.Json.JsonException)
                {
                    ShowMessage($"Workflow '{tab.Name}' could not be restored ({ex.Message}); starting from the example.");
                }
            }
            LoadExample();
        }
        finally { _restoring = false; SyncAppFromDocument(opening: true); }
    }

    void SwitchTab(string id)
    {
        if (id == _tabs.ActiveId || _renamingTab is not null) return;
        CaptureActiveTab();
        _subgraphStack.Clear();
        _tabs.Activate(id);
        ActivateCurrent();
        PersistTabs();
        _studio?.Focus();
    }

    void NewTab()
    {
        CaptureActiveTab();
        _subgraphStack.Clear();
        _tabs.Add("Workflow");
        _restoring = true;
        try { LoadExample(); } finally { _restoring = false; }
        SyncAppFromDocument(opening: false);
        PersistTabs();
        _studio?.Focus();
    }

    void CloseTab(string id)
    {
        bool wasActive = id == _tabs.ActiveId;
        if (wasActive && _subgraphStack.Count > 0) ExitSubgraphTo(0);
        if (!_tabs.Close(id))
        {
            // The only tab: closing it starts over with the example.
            _restoring = true;
            try { LoadExample(); } finally { _restoring = false; }
            PersistTabs();
            return;
        }
        if (wasActive) ActivateCurrent(); else CaptureActiveTab();
        PersistTabs();
        _studio?.Focus();
    }

    void RenameKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "Escape") _renamingTab = null;
    }

    void RenameTab(string id, string? name)
    {
        _tabs.Rename(id, name ?? "");
        _renamingTab = null;
        PersistTabs();
        _studio?.Focus();
    }

    // ---- widget and title editing ----

    void OnWidgetActivated(int nodeId, string name)
    {
        var node = _doc.Graph.GetNode(nodeId);
        // The node's own widget list: it includes widgets that are not in the schema (a dynamic combo's chosen inputs, Custom Combo's options).
        var spec = name == ControlAfterGenerate.Name ? ControlAfterGenerate.Spec
            : Registry.GetSchema(node.ClassType) is { } schema ? NodeLayout.OrderedInputs(schema, node.Widgets).FirstOrDefault(i => i.Name == name)?.Widget : null;
        if (spec is null) return;
        var value = node.Widgets.GetValueOrDefault(name) ?? spec.Default;

        if (spec.Kind == WidgetKind.Boolean)
        {
            _doc.SetWidget(nodeId, name, !(value as bool? ?? false));
            _doc.EndGesture();
            return;
        }

        var geo = _view.Hits.Geometry(node);
        var row = geo.Widgets.First(w => w.Name == name).Bounds;
        var topLeft = _view.Viewport.WorldToScreen(new Point(row.X, row.Y));
        var scale = _view.Viewport.Scale;
        _edit = new EditState
        {
            NodeId = nodeId, Name = name, Spec = spec,
            Bounds = new Rect(topLeft.X, topLeft.Y, row.Width * scale, Math.Max(row.Height * scale, 28)),
            Text = spec.Kind == WidgetKind.Json ? SpawnGen.Engine.Types.JsonLiteral.ToJson(value) : Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "",
        };
        _focusEdit = true;
        StateHasChanged();
    }

    /// <summary>Create Bounding Boxes' panel: the selected box's text or description in a text box over the field, a palette colour in a colour picker.</summary>
    void OnBoxFieldActivated(int nodeId, string name, int index, string field)
    {
        var node = _doc.Graph.GetNode(nodeId);
        var row = _view.Hits.Geometry(node).Widgets.First(w => w.Name == name);
        var (cw, ch) = BoxesWidget.CanvasSize(node.Widgets);
        var lay = BoxesWidget.Lay(row.Bounds, cw, ch);
        var box = BoxesWidget.Boxes(node.Widgets.GetValueOrDefault(name))[index];
        bool colour = field.StartsWith("palette:", StringComparison.Ordinal);
        int swatch = colour ? int.Parse(field[8..], System.Globalization.CultureInfo.InvariantCulture) : -1;
        var at = field == "text" ? lay.TextField : field == "desc" ? lay.DescField : BoxesWidget.Swatch(lay.PaletteRow, swatch);
        var topLeft = _view.Viewport.WorldToScreen(new Point(at.X, at.Y));
        var scale = _view.Viewport.Scale;
        _edit = new EditState
        {
            NodeId = nodeId, Name = name, Box = (index, field),
            Spec = colour ? new WidgetSpec(WidgetKind.Color) : new WidgetSpec(WidgetKind.String) { Multiline = true },
            Bounds = new Rect(topLeft.X, topLeft.Y, Math.Max(at.Width * scale, colour ? 40 : 140), Math.Max(at.Height * scale, 28)),
            Text = field == "text" ? box.Text : field == "desc" ? box.Desc : box.Palette[swatch],
        };
        _focusEdit = true;
        StateHasChanged();
    }

    /// <summary>
    /// The picture a Crop Image node shows: what is linked into its image input, from that node's last result or, for Load Image, its chosen file
    /// (as ComfyUI's editor shows it before any run).
    /// </summary>
    string? CropPictureUrl(EditorNode crop)
    {
        if (_doc.Graph.LinkInto(crop.Id, "image") is not { } link || _doc.Graph.FindNode(link.FromNode) is not { } source) return null;
        if (source.Previews.Count > 0) return source.Previews[0].Url;
        if (_engine is null || source.Widgets.GetValueOrDefault("image") is not string { Length: > 0 } file) return null;
        string? type = source.ClassType switch { "LoadImage" or "LoadImageMask" => "input", "LoadImageOutput" => "output", _ => null };
        if (type is null) return null;
        // An annotated name ("x.png [output]") names its folder; a path's folder part is the subfolder.
        if (file.EndsWith(" [output]", StringComparison.Ordinal)) { file = file[..^9]; type = "output"; }
        else if (file.EndsWith(" [input]", StringComparison.Ordinal)) file = file[..^8];
        int slash = file.LastIndexOf('/');
        return _engine.ViewUrl(slash < 0 ? file : file[(slash + 1)..], slash < 0 ? "" : file[..slash], type);
    }

