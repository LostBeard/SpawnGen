    void OnGroupTitleEdit(int groupId)
    {
        var group = _doc.Graph.GetGroup(groupId);
        var topLeft = _view.Viewport.WorldToScreen(new Point(group.X, group.Y));
        var scale = _view.Viewport.Scale;
        _edit = new EditState
        {
            NodeId = groupId, IsGroup = true, Name = null, Spec = null,
