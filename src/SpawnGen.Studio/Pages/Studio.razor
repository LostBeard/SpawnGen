    sealed class HistoryEntry
    {
        /// <summary>The engine's id of the run (null for a run whose start carried none).</summary>
        public string? PromptId { get; init; }
        /// <summary>A run from before this page was opened, read from the engine's history.</summary>
        public bool Past { get; init; }
        public required int Number { get; init; }
        public required DateTime Started { get; init; }
        public required string Engine { get; init; }
        public required string Workflow { get; init; }
        public List<string> Urls { get; } = [];
        public List<string> Audio { get; } = [];
        public List<string> Models { get; } = [];
        /// <summary>Every result with the node that made it, in arrival order (App Mode's outputs).</summary>
        public List<RunItem> Items { get; } = [];
        public double? Seconds { get; set; }
        public string State { get; set; } = "running";
        public string? Error { get; set; }
        public string? Note { get; set; }
    }

    bool _historyOpen;
    string? _lightbox;
    int _runNumber;
    readonly List<HistoryEntry> _history = [];           // newest first
    sealed record PendingRun(string Id, string Workflow, DateTime At, string Engine);
    readonly List<PendingRun> _pending = [];             // runs waiting in the engine's queue, in the order they start

    async Task CancelQueuedAsync(PendingRun run)
    {
        _pending.Remove(run);
        if (_engine is not null) await _engine.CancelQueuedAsync(run.Id);
    }

