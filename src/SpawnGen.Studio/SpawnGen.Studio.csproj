<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>SpawnGen.Studio</RootNamespace>
    <Description>SpawnGen Studio: the node editor UI (Blazor WebAssembly, canvas drawn from C#).</Description>
    <!-- AOT: publish with -p:StudioAot=true (the GitHub Pages workflow does; it takes an hour or more). The host maths (samplers, image ops, kernel IL compile)
         is the interpreter's otherwise, much slower. WasmStripILAfterAOT=false keeps the IL ILGPU compiles kernels from. WasmDedup stays at its default (smallest
         wasm, slowest build); for a quicker AOT build to try locally add -p:WasmDedup=false. Off by default so ordinary builds and tests stay fast. -->
    <StudioAot Condition="'$(StudioAot)' == ''">false</StudioAot>
    <RunAOTCompilation>$(StudioAot)</RunAOTCompilation>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="SpawnDev.SpawnJS" Version="3.0.7" />
    <PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpawnGen.Engine\SpawnGen.Engine.csproj" />
    <ProjectReference Include="..\SpawnGen.Editor\SpawnGen.Editor.csproj" />
    <ProjectReference Include="..\SpawnGen.Runtime\SpawnGen.Runtime.csproj" />
    <ProjectReference Include="..\SpawnGen.Nodes.Core\SpawnGen.Nodes.Core.csproj" />
    <ProjectReference Include="..\SpawnGen.Nodes.ML\SpawnGen.Nodes.ML.csproj" />
  </ItemGroup>

</Project>
