; Opens a PSD in GIMP (batch mode), prints every layer (name, offsets, size, mode, opacity, visible) and saves the flattened picture as PNG.
; Usage: gimp-console -i -b "(load \"psd-gimp.scm\")" -b "(psd-report \"in.psd\" \"flat.png\")" -b "(gimp-quit 0)"
(define (psd-report in out)
  (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE in in)))
         (layers (gimp-image-get-layers image))
         (count (car layers))
         (ids (cadr layers))
         (i 0))
    (gimp-message (string-append "GIMP canvas " (number->string (car (gimp-image-width image))) "x" (number->string (car (gimp-image-height image)))
                                 " layers " (number->string count)))
    (while (< i count)
      (let* ((layer (vector-ref ids i))
             (offsets (gimp-drawable-offsets layer)))
        (gimp-message (string-append "GIMP layer " (number->string i) ": \"" (car (gimp-item-get-name layer)) "\""
                                     " left " (number->string (car offsets)) " top " (number->string (cadr offsets))
                                     " " (number->string (car (gimp-drawable-width layer))) "x" (number->string (car (gimp-drawable-height layer)))
                                     " mode " (number->string (car (gimp-layer-get-mode layer)))
                                     " opacity " (number->string (car (gimp-layer-get-opacity layer)))
                                     " visible " (number->string (car (gimp-item-get-visible layer)))
                                     " alpha " (number->string (car (gimp-drawable-has-alpha layer))))))
      (set! i (+ i 1)))
    (let ((flat (car (gimp-image-merge-visible-layers image CLIP-TO-IMAGE))))
      (file-png-save RUN-NONINTERACTIVE image flat out out 0 9 0 0 0 0 0))
    (gimp-message "GIMP done")))
